<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexAudio.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:a="using:NexAudio.App.Controls"
             xmlns:p="using:Nexora.Audio.Plugins"
             x:Class="NexAudio.App.Views.NexAudio.ScenesPage"
             x:DataType="vm:NexAudioViewModel">
  <Grid ColumnDefinitions="*,12,*">
    <Border Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,10,Auto,12,*">
        <StackPanel Spacing="3">
          <TextBlock Classes="h3" Text="Scenes" />
          <TextBlock Classes="faint small" TextWrapping="Wrap" Text="A scene is the whole desk for one kind of service: Sunday morning, midweek, youth, a concert. Plugin settings are saved with it." />
          <TextBlock Classes="small" Foreground="{StaticResource Accent}" Text="{Binding CurrentSceneText}" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto">
          <TextBox Text="{Binding NewSceneName}" Watermark="Name, for example Sunday 9am" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding SaveSceneCommand}" Content="Save the desk as a new scene" />
        </Grid>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SceneRows}" />
        </ScrollViewer>
      </Grid>
    </Border>
    <Border Grid.Column="2" Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,10,Auto,10,Auto,12,*">
        <StackPanel Spacing="3">
          <TextBlock Classes="h3" Text="Snapshots during the service" />
          <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Moments within a service: worship, sermon, altar call. Recall them in order with the two big buttons. A snapshot can change only the levels and can fade in." />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,10,*">
          <Button Classes="big" Command="{Binding PreviousSnapshotCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Previous" />
          <Button Grid.Column="2" Classes="big primary" Command="{Binding NextSnapshotCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Next snapshot" />
        </Grid>
        <Border Grid.Row="4" Classes="well" Padding="10">
          <Grid ColumnDefinitions="*,8,170,8,Auto" RowDefinitions="Auto,8,Auto">
            <TextBox Text="{Binding NewSnapshotName}" Watermark="Name, for example Sermon" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding SceneScope}" PlaceholderText="Levels only" HorizontalAlignment="Stretch" />
            <Button Grid.Column="4" Classes="primary" Command="{Binding SaveSnapshotCommand}" Content="Save snapshot" />
            <Grid Grid.Row="2" Grid.ColumnSpan="5" ColumnDefinitions="Auto,10,*,10,50">
              <TextBlock Classes="flabel" Text="Fade in over" />
              <Slider Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SnapshotFade}" Margin="0,-6" />
              <TextBlock Grid.Column="4" Classes="mono small" Text="{Binding SnapshotFade, StringFormat={}{0:0.#} s}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SnapshotRows}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:SceneRow">
      <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderThickness="1"
              BorderBrush="{Binding IsCurrent, Converter={x:Static c:Conv.CurrentBorder}}">
        <Grid ColumnDefinitions="*,8,Auto">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Classes="faint small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost small" Command="{Binding PreviewCommand}" ToolTip.Tip="See what it would change first"><c:Icon Kind="eye" Width="12" Height="12" /></Button>
            <Button Classes="primary small" Command="{Binding RecallCommand}" Content="Recall" />
            <Button Classes="ghost small" Command="{Binding UpdateCommand}" Content="Save over" ToolTip.Tip="Replace this with the desk as it is now" />
            <Button Classes="ghost small" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete"><c:Icon Kind="x" Width="11" Height="11" /></Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
