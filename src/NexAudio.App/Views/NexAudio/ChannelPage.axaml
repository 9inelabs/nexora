<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexAudio.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:a="using:NexAudio.App.Controls"
             x:Class="NexAudio.App.Views.NexAudio.ChannelPage"
             x:DataType="vm:NexAudioViewModel">
  <UserControl.Styles>
    <!-- Section rail -->
    <Style Selector="Button.sect">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.sect:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Button.sect.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <!-- Home tiles -->
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <!-- On / off pills -->
    <Style Selector="ToggleButton.pill">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="ToggleButton.pill.red:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Live}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Segmented choices -->
    <Style Selector="ListBox.seg">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.seg ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ListBox.seg ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="a|Knob">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="102" />
    </Style>
    <Style Selector="a|Knob.big">
      <Setter Property="Width" Value="110" />
      <Setter Property="Height" Value="136" />
    </Style>
    <Style Selector="a|Knob.small">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="84" />
    </Style>
    <!-- Home dashboard -->
    <Style Selector="Border.dash">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Button.head">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2,2" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.head:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="TextBlock.dtitle">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.mini">
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.mini:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#121316" />
    </Style>
    <Style Selector="ToggleButton.mini.input:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource InputTone}" /></Style>
    <Style Selector="ToggleButton.mini.gate:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource GateTone}" /></Style>
    <Style Selector="ToggleButton.mini.eq:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource EqTone}" /></Style>
    <Style Selector="ToggleButton.mini.dyn:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource DynTone}" /></Style>
    <Style Selector="ToggleButton.mini.red:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Live}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="a|Knob.mini">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="74" />
    </Style>
    <Style Selector="Button.bandcell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.bandcell.sel /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource EqTint}" />
    </Style>
    <Style Selector="Button.slotrow">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.slotrow.empty">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.lampx">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Border.lampx TextBlock">
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
    </Style>
    <Style Selector="Border.lampx.on"><Setter Property="Background" Value="{StaticResource FxTone}" /></Style>
    <Style Selector="Border.lampx.on TextBlock"><Setter Property="Foreground" Value="#121316" /></Style>
    <Style Selector="Slider.send">
      <Setter Property="Margin" Value="0,-10" />
    </Style>
    <Style Selector="TextBlock.sectitle">
      <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
      <Setter Property="FontSize" Value="20" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,10,*">
    <!-- Which strip is open -->
    <Border Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="Auto,6,Auto,12,Auto,12,*,12,Auto">
        <Button Classes="ghost" Command="{Binding StepSelectionCommand}" CommandParameter="-1" ToolTip.Tip="Previous strip">
          <c:Icon Kind="left" Width="16" Height="16" />
        </Button>
        <Button Grid.Column="2" Classes="ghost" Command="{Binding StepSelectionCommand}" CommandParameter="1" ToolTip.Tip="Next strip">
          <c:Icon Kind="right" Width="16" Height="16" />
        </Button>
        <Border Grid.Column="4" Width="5" CornerRadius="3" Background="{Binding SelectedStripView.Colour, FallbackValue={StaticResource Surface3}}" />
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Classes="eyebrow" Text="{Binding SelectedKind}" />
            <TextBlock Classes="h2" Text="{Binding SelectedTitle}" />
          </StackPanel>
          <TextBox Text="{Binding SelectedName}" Watermark="Name" Width="120" VerticalAlignment="Center" />
          <Button Command="{Binding RenameCommand}" Content="Rename" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="restart" Width="13" Height="13" /><TextBlock Text="Undo" /></StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}" Content="Redo" />
          <Border Classes="hairline" Width="1" Height="24" Margin="4,0" />
          <Button Command="{Binding CopyStripCommand}" Content="Copy" ToolTip.Tip="Copy this strip's sound (not its level, sends or routing)" />
          <Button Command="{Binding PasteStripCommand}" IsEnabled="{Binding HasClipboard}" ToolTip.Tip="{Binding ClipboardName, StringFormat='Paste from {0}'}" Content="Paste" />
          <ComboBox ItemsSource="{x:Static vm:NexAudioViewModel.PasteParts}" SelectedItem="{Binding PastePart}" MinWidth="150"
                    ToolTip.Tip="What Paste and Load bring over" />
          <Border Classes="hairline" Width="1" Height="24" Margin="4,0" />
          <ComboBox ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding PresetChoice}" MinWidth="190" PlaceholderText="Presets" />
          <Button Classes="primary" Command="{Binding LoadPresetCommand}" Content="Load" />
          <TextBox Text="{Binding NewPresetName}" Watermark="New preset name" Width="140" />
          <Button Command="{Binding SavePresetCommand}" Content="Save" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="172,12,*,12,150">
      <!-- Section rail -->
      <Border Classes="card" Padding="8">
        <ItemsControl ItemsSource="{Binding Rail}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelRailItem">
              <Button Classes="sect" Classes.current="{Binding IsCurrent}" Command="{Binding OpenCommand}">
                <Grid ColumnDefinitions="3,10,*,Auto" Margin="0,9,10,9">
                  <Border CornerRadius="2" Background="{Binding Tone}" IsVisible="{Binding IsCurrent}" />
                  <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{Binding TitleBrush}" />
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{Binding Tone}" IsVisible="{Binding IsOn}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- The open section -->
      <Panel Grid.Column="2">

        <!-- HOME: the whole strip on one screen. Knobs work here too; each card's title opens its full page. -->
        <Grid IsVisible="{Binding OnChHome}" RowDefinitions="1.05*,8,*" ColumnDefinitions="*,8,*,8,*,8,*">

          <!-- INPUT -->
          <Border Classes="dash" a:Paint.Tint="{StaticResource InputTone}">
            <Grid RowDefinitions="Auto,6,*,6,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Input">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource InputTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource InputTone}" Text="INPUT" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <ToggleButton Classes="mini red" IsChecked="{Binding Ch.Phantom.Value}" Content="48V" IsVisible="{Binding Ch.IsChannel}" />
                  <ToggleButton Classes="mini input" IsChecked="{Binding Ch.Invert.Value}" Content="Ø" />
                  <ToggleButton Classes="mini input" IsChecked="{Binding Ch.HpfOn.Value}" Content="LOW CUT" />
                  <ToggleButton Classes="mini input" IsChecked="{Binding Ch.LpfOn.Value}" Content="HI CUT" />
                  <ToggleButton Classes="mini input" IsChecked="{Binding Ch.DriveOn.Value}" Content="DRIVE" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,8,12">
                <a:HistoryGraph History="{Binding GateHistory}" ShowReduction="False" IsHitTestVisible="False" />
                <a:BarMeter Grid.Column="2" Vertical="True" Minimum="-60" Maximum="0" Value="{Binding SelectedIn}" Fill="{StaticResource PreviewBrush}" IsHitTestVisible="False" />
              </Grid>
              <UniformGrid Grid.Row="4" Rows="1">
                <a:Knob Classes="mini" Bipolar="True" Source="{Binding Ch.Preamp}" IsVisible="{Binding Ch.IsChannel}" />
                <a:Knob Classes="mini" Bipolar="True" Source="{Binding Ch.Trim}" />
                <a:Knob Classes="mini" Source="{Binding Ch.Delay}" />
                <a:Knob Classes="mini" Source="{Binding Ch.HpfFreq}" IsActive="{Binding Ch.HpfOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.LpfFreq}" IsActive="{Binding Ch.LpfOn.Value}" />
              </UniformGrid>
            </Grid>
          </Border>

          <!-- GATE -->
          <Border Grid.Column="2" Classes="dash" a:Paint.Tint="{StaticResource GateTone}" IsEnabled="{Binding Ch.HasGate}">
            <Grid RowDefinitions="Auto,6,*,6,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Gate">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource GateTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource GateTone}" Text="GATE" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="faint" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding Ch.GateMode.Selected.Label}" />
                  <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource GateTone}" VerticalAlignment="Center" Text="{Binding SelectedGate, StringFormat='GR -{0:0.0}'}" />
                  <ToggleButton Classes="mini gate" IsChecked="{Binding Ch.GateOn.Value}" Content="ON" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
                <a:DynamicsGraph IsGate="True" ShowScale="False" IsHitTestVisible="False" IsOn="{Binding Ch.GateOn.Value}"
                                 Threshold="{Binding Ch.GateThreshold.Value}" Range="{Binding Ch.GateRange.Value}" InputDb="{Binding SelectedIn}" />
                <a:HistoryGraph Grid.Column="2" History="{Binding GateHistory}" IsHitTestVisible="False" />
              </Grid>
              <UniformGrid Grid.Row="4" Rows="1">
                <a:Knob Classes="mini" Source="{Binding Ch.GateThreshold}" IsActive="{Binding Ch.GateOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.GateRange}" IsActive="{Binding Ch.GateOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.GateAttack}" IsActive="{Binding Ch.GateOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.GateHold}" IsActive="{Binding Ch.GateOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.GateRelease}" IsActive="{Binding Ch.GateOn.Value}" />
              </UniformGrid>
            </Grid>
          </Border>

          <!-- EQ: the curve can be dragged right here -->
          <Border Grid.Column="4" Grid.ColumnSpan="3" Classes="dash" a:Paint.Tint="{StaticResource EqTone}">
            <Grid RowDefinitions="Auto,6,*,6,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Eq">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource EqTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource EqTone}" Text="PARAMETRIC EQ" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="faint small" VerticalAlignment="Center" Text="Drag a point · wheel for width" />
                  <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource EqTone}" VerticalAlignment="Center" Text="{Binding SelectedDynEq, StringFormat='DYN {0:0.0} dB'}" />
                  <Button Classes="ghost small" Command="{Binding FlattenEqCommand}" Content="Flat" />
                  <ToggleButton Classes="mini eq" IsChecked="{Binding Ch.DynEqOn.Value}" Content="DYNAMIC" />
                  <ToggleButton Classes="mini eq" IsChecked="{Binding Ch.EqOn.Value}" Content="ON" />
                </StackPanel>
              </Grid>
              <a:EqCurve Grid.Row="2" Settings="{Binding SelectedFilters}" Spectrum="{Binding Spectrum}" Editor="{Binding}" SelectedBand="{Binding SelectedBand}" />
              <ItemsControl Grid.Row="4" ItemsSource="{Binding Ch.Bands}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EqBandView">
                    <Button Classes="bandcell" Classes.sel="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="Auto,6,*" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.RowSpan="3" Width="18" Height="18" CornerRadius="9" Background="{StaticResource EqTint}" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EqTone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                          <TextBlock Classes="faint" FontSize="9" FontWeight="Bold" Text="{Binding ShapeText}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="mono faint" FontSize="9.5" Text="{Binding Q.Text, StringFormat='Q {0}'}" />
                        </Grid>
                        <TextBlock Grid.Column="2" Grid.Row="1" Classes="mono" FontSize="11.5" Text="{Binding Freq.Text}" />
                        <TextBlock Grid.Column="2" Grid.Row="2" Classes="mono" FontSize="11" Foreground="{StaticResource EqTone}" Text="{Binding Gain.Text}" IsVisible="{Binding HasGain}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- COMPRESSOR -->
          <Border Grid.Row="2" Classes="dash" a:Paint.Tint="{StaticResource DynTone}">
            <Grid RowDefinitions="Auto,6,*,6,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Dynamics">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource DynTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource DynTone}" Text="COMPRESSOR" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource DynTone}" VerticalAlignment="Center" Text="{Binding SelectedComp, StringFormat='GR -{0:0.0}'}" />
                  <ToggleButton Classes="mini dyn" IsChecked="{Binding Ch.CompOn.Value}" Content="{Binding Ch.CompStyle.Selected.Label, FallbackValue=ON}" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
                <a:DynamicsGraph ShowScale="False" IsHitTestVisible="False" IsOn="{Binding Ch.CompOn.Value}"
                                 Threshold="{Binding Ch.CompThreshold.Value}" Ratio="{Binding Ch.CompRatio.Value}" Knee="{Binding Ch.CompKnee.Value}"
                                 Makeup="{Binding CompMakeupNow}" InputDb="{Binding SelectedIn}" />
                <a:HistoryGraph Grid.Column="2" History="{Binding CompHistory}" IsHitTestVisible="False" />
              </Grid>
              <UniformGrid Grid.Row="4" Rows="1">
                <a:Knob Classes="mini" Source="{Binding Ch.CompThreshold}" IsActive="{Binding Ch.CompOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.CompRatio}" IsActive="{Binding Ch.CompOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.CompAttack}" IsActive="{Binding Ch.CompOn.Value}" />
                <a:Knob Classes="mini" Source="{Binding Ch.CompRelease}" IsActive="{Binding Ch.CompOn.Value}" />
                <a:Knob Classes="mini" Bipolar="True" Source="{Binding Ch.CompMakeup}" IsActive="{Binding Ch.CompOn.Value}" />
              </UniformGrid>
            </Grid>
          </Border>

          <!-- EFFECTS RACK -->
          <Border Grid.Row="2" Grid.Column="2" Classes="dash" a:Paint.Tint="{StaticResource FxTone}">
            <Grid RowDefinitions="Auto,6,*">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Effects">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource FxTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource FxTone}" Text="EFFECTS AND INSERTS" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Classes="mono faint" FontSize="10.5" VerticalAlignment="Center" Text="{Binding SelectedRack, StringFormat='GR -{0:0.0}'}" />
              </Grid>
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RackSlotView">
                    <Button Classes="slotrow" Classes.empty="{Binding IsEmpty}" Command="{Binding OpenCommand}">
                      <Grid ColumnDefinitions="20,*,Auto,6,Auto">
                        <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource FxTone}" Text="{Binding Number}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" Classes.faint="{Binding IsEmpty}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="faint" FontSize="10" Text="{Binding Detail}" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Classes="lampx" Classes.on="{Binding IsActive}" IsVisible="{Binding !IsEmpty}">
                          <TextBlock Text="{Binding IsBypassed, Converter={x:Static c:Conv.YesNo}, ConverterParameter='BYP|ON'}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- SENDS -->
          <Border Grid.Row="2" Grid.Column="4" Classes="dash" a:Paint.Tint="{StaticResource SendTone}">
            <Grid RowDefinitions="Auto,6,*">
              <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Sends">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource SendTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource SendTone}" Text="BUS SENDS" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
              </Button>
              <TextBlock Grid.Row="2" Classes="faint small" Text="This strip feeds no buses." IsVisible="{Binding !Ch.HasSends}" TextWrapping="Wrap" />
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Ch.Sends}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SendView">
                      <Grid ColumnDefinitions="4,6,74,6,*,4,48,4,Auto" Margin="0,3">
                        <Border CornerRadius="2" Background="{Binding Tone}" />
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                          <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Kind}" />
                          <ComboBox Classes="tap" Width="74" Height="20" MinHeight="20" Padding="4,0,0,0" FontSize="9" ItemsSource="{Binding Taps}" SelectedItem="{Binding Tap}" ToolTip.Tip="Where this send is taken from" />
                        </StackPanel>
                        <Slider Grid.Column="4" Classes="send" Minimum="0" Maximum="1000" Value="{Binding Level.Position}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Classes="mono" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Level.Text}" />
                        <ToggleButton Grid.Column="8" Classes="mini" IsChecked="{Binding On.Value}" Content="ON" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- GRAPHIC EQ and ROUTING -->
          <Grid Grid.Row="2" Grid.Column="6" RowDefinitions="*,8,Auto">
            <Border Classes="dash" a:Paint.Tint="{StaticResource EqTone}">
              <Grid RowDefinitions="Auto,6,*">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="head" Command="{Binding OpenSectionCommand}" CommandParameter="Geq">
                    <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource EqTone}" /><TextBlock Classes="dtitle" Foreground="{StaticResource EqTone}" Text="GRAPHIC EQ" /><c:Icon Kind="right" Width="10" Height="10" /></StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="ghost small" Command="{Binding AddGeqCommand}" IsVisible="{Binding !HasGeq}" Content="Add" />
                  <TextBlock Grid.Column="1" Classes="faint" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding HasGeq}" Text="31 bands" />
                </Grid>
                <a:GraphicEqControl Grid.Row="2" Compact="True" IsHitTestVisible="False" Values="{Binding GeqValues}" IsOn="{Binding GeqOn}" />
              </Grid>
            </Border>
            <Border Grid.Row="2" Classes="dash">
              <StackPanel Spacing="4">
                <TextBlock Classes="dtitle" Foreground="{StaticResource Text2}" Text="ROUTING" />
                <TextBlock FontSize="12" Text="{Binding HomeRoutingText}" TextWrapping="Wrap" />
                <TextBlock Classes="faint small" Text="{Binding HomeInputText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- INPUT -->
        <ScrollViewer IsVisible="{Binding OnChInput}" a:Paint.Tint="{StaticResource InputTone}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="18,14">
              <Grid ColumnDefinitions="Auto,24,*">
                <StackPanel Spacing="10">
                  <TextBlock Classes="sectitle" Text="Gain and polarity" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <a:Knob Classes="big" Bipolar="True" Source="{Binding Ch.Preamp}" IsVisible="{Binding Ch.IsChannel}" />
                    <a:Knob Classes="big" Bipolar="True" Source="{Binding Ch.Trim}" />
                    <a:Knob Classes="big" Source="{Binding Ch.Delay}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton Classes="pill red" IsChecked="{Binding Ch.Phantom.Value}" Content="+48 V" IsVisible="{Binding Ch.IsChannel}" />
                    <ToggleButton Classes="pill" IsChecked="{Binding Ch.Invert.Value}" Content="Ø  Polarity flip" />
                  </StackPanel>
                  <TextBlock Classes="faint small" MaxWidth="340" TextWrapping="Wrap" HorizontalAlignment="Left"
                             Text="X32 gain and +48 V change the preamp on the desk itself, over the network. Trim and delay happen in NEX-Audio." />
                </StackPanel>
                <Grid Grid.Column="2" RowDefinitions="Auto,8,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="eyebrow" Text="INPUT LEVEL, LAST 6 SECONDS" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SelectedIn, StringFormat='{}{0:0.0} dB'}" />
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="*,10,16" MinHeight="230">
                    <a:HistoryGraph History="{Binding GateHistory}" ShowReduction="False" />
                    <a:BarMeter Grid.Column="2" Vertical="True" Minimum="-60" Maximum="0" Value="{Binding SelectedIn}" Fill="{StaticResource PreviewBrush}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>
            <Border Classes="card" Padding="18,14">
              <Grid ColumnDefinitions="Auto,24,*">
                <StackPanel Spacing="10">
                  <TextBlock Classes="sectitle" Text="Low cut and high cut" />
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                      <a:Knob Source="{Binding Ch.HpfFreq}" IsActive="{Binding Ch.HpfOn.Value}" />
                      <ToggleButton Classes="pill" HorizontalAlignment="Center" IsChecked="{Binding Ch.HpfOn.Value}" Content="Low cut" />
                      <ListBox Classes="seg" ItemsSource="{Binding Ch.HpfSlope.Options}" SelectedItem="{Binding Ch.HpfSlope.Selected}" />
                    </StackPanel>
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                      <a:Knob Source="{Binding Ch.LpfFreq}" IsActive="{Binding Ch.LpfOn.Value}" />
                      <ToggleButton Classes="pill" HorizontalAlignment="Center" IsChecked="{Binding Ch.LpfOn.Value}" Content="High cut" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <a:EqCurve Grid.Column="2" MinHeight="200" Settings="{Binding SelectedFilters}" Spectrum="{Binding Spectrum}" ShowBands="False" />
              </Grid>
            </Border>
            <Border Classes="card" Padding="18,14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectitle" Text="Drive" />
                    <TextBlock Classes="faint small" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               Text="Adds harmonics and rounds off peaks, after the low and high cut. Warm is thick and rounded; Edge is brighter and firmer. The level is matched afterwards, so you hear colour, not just loudness." />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <a:Knob Classes="big" Source="{Binding Ch.DriveAmount}" IsActive="{Binding Ch.DriveOn.Value}" />
                    <a:Knob Source="{Binding Ch.DriveMix}" IsActive="{Binding Ch.DriveOn.Value}" VerticalAlignment="Center" />
                    <a:Knob Bipolar="True" Source="{Binding Ch.DriveOutput}" IsActive="{Binding Ch.DriveOn.Value}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                  <ToggleButton Classes="pill" IsChecked="{Binding Ch.DriveOn.Value}" Content="Drive on" HorizontalAlignment="Right" />
                  <ListBox Classes="seg" ItemsSource="{Binding Ch.DriveStyle.Options}" SelectedItem="{Binding Ch.DriveStyle.Selected}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- GATE -->
        <ScrollViewer IsVisible="{Binding OnChGate}" a:Paint.Tint="{StaticResource GateTone}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="18,14">
              <Grid RowDefinitions="Auto,12,Auto">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectitle" Text="Gate / ducker" />
                    <TextBlock Classes="faint small" Text="A gate turns the sound down while it is quiet, so spill and noise stay out. A ducker dips it while what it listens to is loud." />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="pill" IsChecked="{Binding Ch.GateOn.Value}" Content="On" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="300,16,*,16,40" Height="300">
                  <a:DynamicsGraph IsGate="True" IsOn="{Binding Ch.GateOn.Value}" Threshold="{Binding Ch.GateThreshold.Value}"
                                   Range="{Binding Ch.GateRange.Value}" InputDb="{Binding SelectedIn}" />
                  <a:HistoryGraph Grid.Column="2" History="{Binding GateHistory}" Threshold="{Binding Ch.GateThreshold.Value}" ReductionRange="{Binding Ch.GateRange.Value}" />
                  <Grid Grid.Column="4" RowDefinitions="Auto,6,*">
                    <TextBlock Classes="eyebrow" Text="GR" HorizontalAlignment="Center" />
                    <a:BarMeter Grid.Row="2" Vertical="True" FromTop="True" Minimum="0" Maximum="{Binding Ch.GateRange.Value}" Value="{Binding SelectedGate}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>
            <Border Classes="card" Padding="18,14">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <a:Knob Classes="big" Source="{Binding Ch.GateThreshold}" IsActive="{Binding Ch.GateOn.Value}" />
                <a:Knob Classes="big" Source="{Binding Ch.GateRange}" IsActive="{Binding Ch.GateOn.Value}" />
                <Border Classes="hairline" Width="1" Height="100" />
                <a:Knob Source="{Binding Ch.GateAttack}" IsActive="{Binding Ch.GateOn.Value}" VerticalAlignment="Center" />
                <a:Knob Source="{Binding Ch.GateHold}" IsActive="{Binding Ch.GateOn.Value}" VerticalAlignment="Center" />
                <a:Knob Source="{Binding Ch.GateRelease}" IsActive="{Binding Ch.GateOn.Value}" VerticalAlignment="Center" />
                <Border Classes="hairline" Width="1" Height="100" />
                <a:Knob Source="{Binding Ch.GateKey}" IsActive="{Binding Ch.GateOn.Value}" VerticalAlignment="Center" />
                <TextBlock Classes="faint small" Width="200" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Key filter: the gate listens above this pitch, so a kick drum's boom does not open the snare's gate." />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="18,14">
              <Grid ColumnDefinitions="Auto,24,Auto,24,*">
                <StackPanel Spacing="8">
                  <TextBlock Classes="eyebrow" Text="MODE" />
                  <ListBox Classes="seg" ItemsSource="{Binding Ch.GateMode.Options}" SelectedItem="{Binding Ch.GateMode.Selected}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Classes="eyebrow" Text="LISTENS TO (SIDECHAIN)" />
                  <ComboBox ItemsSource="{Binding Ch.GateKeySource.Options}" SelectedItem="{Binding Ch.GateKeySource.Selected}" MinWidth="220" />
                </StackPanel>
                <TextBlock Grid.Column="4" Classes="faint small" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Gate turns this channel down while what it listens to is quiet. Ducker does the opposite: it dips this channel while what it listens to is loud. For example, put a ducker on the music playback, listening to the pastor's mic, so the music drops whenever the pastor speaks." />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- EQ -->
        <ScrollViewer IsVisible="{Binding OnChEq}" a:Paint.Tint="{StaticResource EqTone}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="18,14">
              <Grid RowDefinitions="Auto,10,Auto">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectitle" Text="Parametric EQ" />
                    <TextBlock Classes="faint small" Text="Drag a numbered dot to move its band. Use the mouse wheel over a dot to make it wider or narrower. The shaded shape behind is what this strip is playing now." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="small ghost" Command="{Binding FlattenEqCommand}" Content="Flatten" />
                    <ToggleButton Classes="pill" IsChecked="{Binding Ch.EqOn.Value}" Content="EQ on" />
                  </StackPanel>
                </Grid>
                <a:EqCurve Grid.Row="2" Height="250" Settings="{Binding SelectedFilters}" Spectrum="{Binding Spectrum}"
                           Editor="{Binding}" SelectedBand="{Binding SelectedBand}" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Ch.Bands}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EqBandView">
                  <Border Classes="card" Padding="10,10" Margin="0,0,10,0" BorderBrush="{Binding IsSelected, Converter={x:Static c:Conv.CurrentBorder}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                      <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding SelectCommand}">
                        <Grid ColumnDefinitions="Auto,8,*">
                          <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface3}">
                            <TextBlock Classes="mono" FontSize="11" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding ShapeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                      <ComboBox ItemsSource="{Binding Shape.Options}" SelectedItem="{Binding Shape.Selected}" HorizontalAlignment="Stretch" FontSize="12" />
                      <UniformGrid Columns="2">
                        <a:Knob Classes="small" HorizontalAlignment="Center" Source="{Binding Freq}" IsActive="{Binding On.Value}" />
                        <a:Knob Classes="small" HorizontalAlignment="Center" Bipolar="True" Source="{Binding Gain}" IsActive="{Binding On.Value}" IsEnabled="{Binding HasGain}" />
                      </UniformGrid>
                      <UniformGrid Columns="2">
                        <a:Knob Classes="small" HorizontalAlignment="Center" Source="{Binding Q}" IsActive="{Binding On.Value}" />
                        <ToggleButton Classes="pill" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding On.Value}" Content="On" />
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card" Padding="18,14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectitle" Text="Dynamic EQ" />
                    <TextBlock Classes="faint small" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                               Text="Bells that only move when their own range gets loud: tame a harsh note or a boomy word at the moment it happens and leave the rest of the voice alone." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="mono" Foreground="{StaticResource EqTone}" VerticalAlignment="Center" Text="{Binding SelectedDynEq, StringFormat='moving {0:0.0} dB'}" />
                    <ToggleButton Classes="pill" IsChecked="{Binding Ch.DynEqOn.Value}" Content="Dynamic EQ on" />
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Ch.DynBands}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DynEqBandView">
                      <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="eyebrow" Foreground="{StaticResource EqTone}" Text="{Binding Title}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" Classes="pill" IsChecked="{Binding On.Value}" Content="On" />
                          </Grid>
                          <UniformGrid Rows="1">
                            <a:Knob Classes="small" Source="{Binding Freq}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Source="{Binding Q}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Source="{Binding Threshold}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Bipolar="True" Source="{Binding Range}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Source="{Binding Ratio}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Source="{Binding Attack}" IsActive="{Binding On.Value}" />
                            <a:Knob Classes="small" Source="{Binding Release}" IsActive="{Binding On.Value}" />
                          </UniformGrid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="Auto,16,*">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="ORDER" />
                    <ListBox Classes="seg" ItemsSource="{Binding Ch.Order.Options}" SelectedItem="{Binding Ch.Order.Selected}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="faint small" TextWrapping="Wrap" VerticalAlignment="Center"
                             Text="EQ first: the gate and compressor hear the EQ'd sound. Dynamics first: boosting the EQ never pushes the compressor harder." />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- COMPRESSOR -->
        <ScrollViewer IsVisible="{Binding OnChDynamics}" a:Paint.Tint="{StaticResource DynTone}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="18,14">
              <Grid RowDefinitions="Auto,12,Auto">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sectitle" Text="Compressor" />
                    <TextBlock Classes="faint small" Text="Evens out the level: loud moments come down, so the quiet ones can sit higher." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ListBox Classes="seg" ItemsSource="{Binding Ch.CompStyle.Options}" SelectedItem="{Binding Ch.CompStyle.Selected}" />
                    <ToggleButton Classes="pill" IsChecked="{Binding Ch.CompOn.Value}" Content="Compressor on" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="300,16,*,16,40" Height="300">
                  <a:DynamicsGraph IsOn="{Binding Ch.CompOn.Value}" Threshold="{Binding Ch.CompThreshold.Value}" Ratio="{Binding Ch.CompRatio.Value}"
                                   Knee="{Binding Ch.CompKnee.Value}" Makeup="{Binding CompMakeupNow}" InputDb="{Binding SelectedIn}" />
                  <a:HistoryGraph Grid.Column="2" History="{Binding CompHistory}" Threshold="{Binding Ch.CompThreshold.Value}" ReductionRange="24" />
                  <Grid Grid.Column="4" RowDefinitions="Auto,6,*">
                    <TextBlock Classes="eyebrow" Text="GR" HorizontalAlignment="Center" />
                    <a:BarMeter Grid.Row="2" Vertical="True" FromTop="True" Minimum="0" Maximum="24" Value="{Binding SelectedComp}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>
            <Border Classes="card" Padding="18,14">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <a:Knob Classes="big" Source="{Binding Ch.CompThreshold}" IsActive="{Binding Ch.CompOn.Value}" />
                <a:Knob Classes="big" Source="{Binding Ch.CompRatio}" IsActive="{Binding Ch.CompOn.Value}" />
                <Border Classes="hairline" Width="1" Height="100" />
                <a:Knob Source="{Binding Ch.CompAttack}" IsActive="{Binding Ch.CompOn.Value}" VerticalAlignment="Center" />
                <a:Knob Source="{Binding Ch.CompRelease}" IsActive="{Binding Ch.CompOn.Value}" VerticalAlignment="Center" />
                <a:Knob Source="{Binding Ch.CompKnee}" IsActive="{Binding Ch.CompOn.Value}" VerticalAlignment="Center" />
                <Border Classes="hairline" Width="1" Height="100" />
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <a:Knob Bipolar="True" Source="{Binding Ch.CompMakeup}" IsActive="{Binding Ch.CompOn.Value}" />
                  <ToggleButton Classes="pill" HorizontalAlignment="Center" IsChecked="{Binding Ch.CompAuto.Value}" Content="Auto" />
                </StackPanel>
                <a:Knob Source="{Binding Ch.CompMix}" IsActive="{Binding Ch.CompOn.Value}" VerticalAlignment="Center" />
                <a:Knob Source="{Binding Ch.CompKey}" IsActive="{Binding Ch.CompOn.Value}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="18,14">
              <Grid ColumnDefinitions="Auto,24,Auto,24,*">
                <StackPanel Spacing="8">
                  <TextBlock Classes="eyebrow" Text="LISTENS TO (SIDECHAIN)" />
                  <ComboBox ItemsSource="{Binding Ch.CompKeySource.Options}" SelectedItem="{Binding Ch.CompKeySource.Selected}" MinWidth="220" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Classes="eyebrow" Text="ORDER" />
                  <ListBox Classes="seg" ItemsSource="{Binding Ch.Order.Options}" SelectedItem="{Binding Ch.Order.Selected}" />
                </StackPanel>
                <TextBlock Grid.Column="4" Classes="faint small" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Listening to another channel turns this one down when that channel is loud, for example the band group under the worship leader's mic." />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- GRAPHIC EQ -->
        <Panel IsVisible="{Binding OnChGeq}" a:Paint.Tint="{StaticResource EqTone}">
          <Border Classes="card" Padding="18,14" IsVisible="{Binding HasGeq}">
            <Grid RowDefinitions="Auto,12,*">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectitle" Text="Graphic EQ, 31 bands" />
                  <TextBlock Classes="faint small" Text="Drag across the faders to draw a shape. Double-click a fader to put it back to 0 dB. Best on wedges, side fills and the main speakers to tame feedback and room boom." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="small ghost" Command="{Binding FlattenGeqCommand}" Content="Flatten" />
                  <Button Classes="small ghost" Command="{Binding RemoveGeqCommand}" Content="Remove" />
                  <ToggleButton Classes="pill" IsChecked="{Binding GeqBypass.Value}" Content="Bypass" />
                </StackPanel>
              </Grid>
              <a:GraphicEqControl Grid.Row="2" Values="{Binding GeqValues}" Editor="{Binding}" IsOn="{Binding GeqOn}" />
            </Grid>
          </Border>
          <Border Classes="card" Padding="28" IsVisible="{Binding !HasGeq}" VerticalAlignment="Top">
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Classes="sectitle" Text="No graphic EQ on this strip yet" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="A 31-band graphic EQ goes first in the effects rack. Use it on monitor mixes, side fills and the main speakers to pull out feedback and room boom, one third of an octave at a time." />
              <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding AddGeqCommand}" Content="Add a graphic EQ" />
            </StackPanel>
          </Border>
        </Panel>

        <!-- EFFECTS -->
        <Grid IsVisible="{Binding OnChEffects}" a:Paint.Tint="{StaticResource FxTone}" ColumnDefinitions="260,12,*">
          <Border Classes="card" Padding="10">
            <Grid RowDefinitions="Auto,8,*,8,Auto">
              <TextBlock Classes="eyebrow" Margin="6,2" Text="EFFECTS RACK" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RackSlotView">
                    <Button Classes="sect" Classes.current="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="26,*,Auto" Margin="8,8,10,8">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Surface3}">
                          <TextBlock Classes="mono" FontSize="10" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="0" Margin="6,0,0,0">
                          <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}" Classes.faint="{Binding IsEmpty}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" FontSize="10.5" Text="{Binding Detail}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="ind" IsVisible="{Binding IsBypassed}"><TextBlock Text="BYPASS" /></Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Grid.Row="4" ColumnDefinitions="*,6,Auto">
                <ComboBox ItemsSource="{Binding AddChoices}" SelectedItem="{Binding AddChoice}" HorizontalAlignment="Stretch" FontSize="12" />
                <Button Grid.Column="2" Classes="primary" Command="{Binding AddEffectHereCommand}" Content="Add" />
              </Grid>
            </Grid>
          </Border>
          <Panel Grid.Column="2">
            <Border Classes="card" Padding="28" IsVisible="{Binding SelectedSlotEmpty}" VerticalAlignment="Top">
              <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Classes="sectitle" Text="This place in the rack is empty" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Pick an effect at the bottom of the rack and press Add. NEX-Audio's own reverbs, delay, chorus, de-esser, pitch correction and dynamics are there, and any VST3 plugins found on the Plugins tab." />
              </StackPanel>
            </Border>
            <ScrollViewer IsVisible="{Binding !SelectedSlotEmpty}" VerticalScrollBarVisibility="Auto">
              <Border Classes="card" Padding="18,14" DataContext="{Binding SelectedRackView}" x:DataType="vm:RackItemView">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="sectitle" Text="{Binding Name}" />
                      <TextBlock Classes="faint small" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Classes="ghost small" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="Earlier in the rack"><c:Icon Kind="arrowup" Width="12" Height="12" /></Button>
                      <Button Classes="ghost small" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="Later in the rack"><c:Icon Kind="arrowdown" Width="12" Height="12" /></Button>
                      <Button Classes="ghost small" Command="{Binding RemoveCommand}" Content="Remove" />
                      <ToggleButton Classes="pill" IsChecked="{Binding Pre.Value}" Content="Before EQ"
                                    ToolTip.Tip="On: this effect sits at the top of the strip, before the EQ and dynamics (an insert). Off: after them." />
                      <ToggleButton Classes="pill" IsChecked="{Binding Bypass.Value}" Content="Bypass" />
                    </StackPanel>
                  </Grid>
                  <a:EffectGraph Height="230" Item="{Binding $parent[UserControl].((vm:NexAudioViewModel)DataContext).SelectedEffect}" IsVisible="{Binding !IsPlugin}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsPlugin}">
                    <Button Classes="primary" Command="{Binding OpenEditorCommand}" Content="Open plugin window" />
                    <Button Command="{Binding RetryCommand}" Content="Restart plugin" />
                    <TextBlock Classes="small" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChoiceParam">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding Label}" />
                          <ListBox Classes="seg" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsVisible="{Binding Options.Count, Converter={x:Static c:Conv.LessThan}, ConverterParameter=6}" />
                          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" MinWidth="120" IsVisible="{Binding Options.Count, Converter={x:Static c:Conv.AtLeast}, ConverterParameter=6}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Knobs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="96" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SliderParam">
                        <a:Knob Source="{Binding}" Margin="0,0,0,8" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Spacing="8" IsVisible="{Binding IsGraphicEq}">
                    <TextBlock Classes="muted" Text="This graphic EQ has its own page with 31 faders." />
                    <Button HorizontalAlignment="Left" Command="{Binding $parent[UserControl].((vm:NexAudioViewModel)DataContext).OpenSectionCommand}" CommandParameter="Geq" Content="Open the graphic EQ" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Panel>
        </Grid>

        <!-- SENDS AND ROUTING -->
        <ScrollViewer IsVisible="{Binding OnChSends}" a:Paint.Tint="{StaticResource SendTone}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="18,14" IsVisible="{Binding Ch.HasSends}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="sectitle" Text="Sends" />
                  <TextBlock Classes="faint small" Text="How much of this strip goes to each monitor mix and effect. The tap point under each knob says where the send is taken from: the input, before or after the EQ, or before (PRE) or after (POST) the fader. PRE keeps the wedges put when the front-of-house fader moves." TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Ch.Sends}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="120" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SendView">
                      <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="8,10" Margin="0,0,10,10">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                          <TextBlock Classes="eyebrow" HorizontalAlignment="Center" Text="{Binding Kind}" />
                          <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="96" />
                          <a:Knob Source="{Binding Level}" ShowLabel="False" Height="86" IsActive="{Binding On.Value}" HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <ToggleButton Classes="pill" MinWidth="0" Padding="8,4" IsChecked="{Binding On.Value}" Content="ON" />
                          </StackPanel>
                          <ComboBox Classes="tap" ItemsSource="{Binding Taps}" SelectedItem="{Binding Tap}" HorizontalAlignment="Center" ToolTip.Tip="Where this send is taken from" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding ChannelSections}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="380" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ParamSection">
                  <Border Classes="card" Padding="16,12" Margin="0,0,12,12">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="sectitle" FontSize="15" Text="{Binding Title}" />
                      <TextBlock Classes="faint small" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                      <ItemsControl ItemsSource="{Binding Items}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>

      <!-- The open strip's own fader, always to hand -->
      <Border Grid.Column="4" Classes="card" Padding="10,12" DataContext="{Binding SelectedStripView}" x:DataType="vm:StripView">
        <Grid RowDefinitions="Auto,6,Auto,4,*,8,Auto,8,Auto,6,Auto">
          <Border Height="4" CornerRadius="2" Background="{Binding Colour, FallbackValue={StaticResource Surface3}}" />
          <StackPanel Grid.Row="2" Spacing="0" HorizontalAlignment="Center">
            <TextBlock Classes="eyebrow" HorizontalAlignment="Center" Text="{Binding Number}" />
            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="128" />
          </StackPanel>
          <a:Fader Grid.Row="4" Value="{Binding Fader}" IsEnabled="{Binding FaderEnabled}" Wide="True"
                   Meters="{Binding $parent[UserControl].((vm:NexAudioViewModel)DataContext).StripMeters}"
                   MeterIndex="{Binding MeterIndex}" MeterIndexR="{Binding MeterIndexR}" />
          <TextBlock Grid.Row="6" Classes="mono" FontSize="16" HorizontalAlignment="Center" Text="{Binding FaderText, StringFormat='{}{0} dB'}" />
          <a:Knob Grid.Row="8" IsVisible="{Binding HasPan}" Classes="small" HorizontalAlignment="Center" Bipolar="True" Label="Pan" Text="{Binding PanText}"
                  Position="{Binding PanPosition}" ResetCommand="{Binding CentrePanCommand}" />
          <StackPanel Grid.Row="10" Spacing="6">
            <Button Classes="strip mute" Classes.active="{Binding Mute}" Classes.group="{Binding GroupMuted}" Command="{Binding ToggleMuteCommand}" Content="MUTE" Padding="0,8" />
            <Button Classes="strip mute" Classes.hard="{Binding HardMute}" Command="{Binding ToggleHardMuteCommand}" Content="HARD MUTE" Padding="0,6" FontSize="10" IsVisible="{Binding CanHardMute}"
                    ToolTip.Tip="Completely silent, the direct out too. Scenes, mute groups and control groups cannot bring it back: only this button does." />
            <Button Classes="strip solo" Classes.active="{Binding Solo}" Command="{Binding ToggleSoloCommand}" Content="SOLO" Padding="0,8" IsVisible="{Binding CanSolo}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
