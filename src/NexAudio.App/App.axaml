<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexAudio.App.ViewModels"
             xmlns:v="using:NexAudio.App.Views"
             x:Class="NexAudio.App.App"
             RequestedThemeVariant="Dark"
             Name="NEX-Audio">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:SignInViewModel"><v:SignInView /></DataTemplate>
    <DataTemplate DataType="vm:NexAudioViewModel"><v:NexAudioView /></DataTemplate>
    <DataTemplate DataType="vm:SliderParam">
      <Grid ColumnDefinitions="128,8,*,8,64" Margin="0,2">
        <TextBlock Classes="flabel" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
        <Slider Grid.Column="2" Classes="param" Minimum="0" Maximum="1000" Value="{Binding Position}" />
        <TextBlock Grid.Column="4" Classes="mono small" Text="{Binding Text}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ToggleParam">
      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
        <TextBlock Classes="flabel" Text="{Binding Label}" TextWrapping="Wrap" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Value}" OnContent="" OffContent="" MinWidth="0" Margin="0,-6" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceParam">
      <Grid ColumnDefinitions="128,8,*" Margin="0,2">
        <TextBlock Classes="flabel" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" FontSize="12.5" />
      </Grid>
    </DataTemplate>

  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Nexora.UI/Theme/Theme.axaml" />
    <StyleInclude Source="avares://NexAudio/Views/DeskStyles.axaml" />
  </Application.Styles>
</Application>
