<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Nexora.App.Controls">
  <!--
    NEXORA design system v3: dark charcoal, hairline borders, no gradients,
    one soft gold accent. Red / green / blue are kept for broadcast state only.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="NxGround">#121316</Color>
      <Color x:Key="NxSurface1">#191A1E</Color>
      <Color x:Key="NxSurface2">#1F2125</Color>
      <Color x:Key="NxSurface3">#272A2F</Color>
      <Color x:Key="NxSurface4">#32353B</Color>
      <Color x:Key="NxText">#F2F2F0</Color>
      <Color x:Key="NxText2">#A4A7AE</Color>
      <Color x:Key="NxText3">#6C6F77</Color>
      <Color x:Key="NxAccent">#E2BE76</Color>
      <Color x:Key="NxOnAccent">#1A1609</Color>
      <Color x:Key="NxLive">#FF5A5F</Color>
      <Color x:Key="NxPreview">#3DD68C</Color>
      <Color x:Key="NxPinned">#5AA9F0</Color>
      <Color x:Key="NxWarn">#F0B44C</Color>
      <Color x:Key="NxOutputBlack">#0C0C0E</Color>
      <Color x:Key="NxOutputAccent">#E9C77E</Color>
      <Color x:Key="NxLine">#12FFFFFF</Color>
      <Color x:Key="NxLine2">#1FFFFFFF</Color>

      <SolidColorBrush x:Key="Ground" Color="{StaticResource NxGround}" />
      <SolidColorBrush x:Key="Surface1" Color="{StaticResource NxSurface1}" />
      <SolidColorBrush x:Key="Surface2" Color="{StaticResource NxSurface2}" />
      <SolidColorBrush x:Key="Surface3" Color="{StaticResource NxSurface3}" />
      <SolidColorBrush x:Key="Surface4" Color="{StaticResource NxSurface4}" />
      <SolidColorBrush x:Key="Text1" Color="{StaticResource NxText}" />
      <SolidColorBrush x:Key="Text2" Color="{StaticResource NxText2}" />
      <SolidColorBrush x:Key="Text3" Color="{StaticResource NxText3}" />
      <SolidColorBrush x:Key="Accent" Color="{StaticResource NxAccent}" />
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource NxOnAccent}" />
      <SolidColorBrush x:Key="Live" Color="{StaticResource NxLive}" />
      <SolidColorBrush x:Key="PreviewBrush" Color="{StaticResource NxPreview}" />
      <SolidColorBrush x:Key="Pinned" Color="{StaticResource NxPinned}" />
      <SolidColorBrush x:Key="Warn" Color="{StaticResource NxWarn}" />
      <SolidColorBrush x:Key="Line" Color="{StaticResource NxLine}" />
      <SolidColorBrush x:Key="Line2" Color="{StaticResource NxLine2}" />
      <SolidColorBrush x:Key="TintAccent" Color="#1FE2BE76" />
      <SolidColorBrush x:Key="TintLive" Color="#1FFF5A5F" />
      <SolidColorBrush x:Key="TintPinned" Color="#1F5AA9F0" />
      <SolidColorBrush x:Key="TintPreview" Color="#1F3DD68C" />
      <SolidColorBrush x:Key="TintWarn" Color="#1FF0B44C" />

      <FontFamily x:Key="FontUi">avares://Nexora/Assets/Fonts#Manrope</FontFamily>
      <FontFamily x:Key="FontDisplay">avares://Nexora/Assets/Fonts#Sora</FontFamily>
      <FontFamily x:Key="FontMono">avares://Nexora/Assets/Fonts#JetBrains Mono</FontFamily>

      <!-- Fluent overrides so stock controls match the palette -->
      <Color x:Key="SystemAccentColor">#E2BE76</Color>
      <Color x:Key="SystemAccentColorLight1">#E8CB8E</Color>
      <Color x:Key="SystemAccentColorLight2">#EED7A6</Color>
      <Color x:Key="SystemAccentColorDark1">#CFAA61</Color>
      <SolidColorBrush x:Key="TextControlBackground" Color="#1F2125" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#272A2F" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F2125" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E2BE76" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#F2F2F0" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F0" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6C6F77" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6C6F77" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#66E2BE76" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E2BE76" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E8CB8E" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A1609" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1609" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#32353B" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A4A7AE" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E2BE76" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E8CB8E" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E2BE76" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#1A1609" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#1A1609" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#1F2125" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1F2125" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#272A2F" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#32353B" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#1F2125" />
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== Base ===== -->
  <Style Selector="TopLevel">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="FontSize" Value="38" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Live}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Background" Value="{StaticResource Surface3}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>

  <!-- ===== Chips ===== -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{StaticResource Surface3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
  </Style>
  <Style Selector="Border.chip Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{StaticResource Text2}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{StaticResource TintPreview}" /></Style>
  <Style Selector="Border.chip.ok TextBlock"><Setter Property="Foreground" Value="{StaticResource PreviewBrush}" /></Style>
  <Style Selector="Border.chip.ok Ellipse"><Setter Property="Fill" Value="{StaticResource PreviewBrush}" /></Style>
  <Style Selector="Border.chip.live"><Setter Property="Background" Value="{StaticResource Live}" /></Style>
  <Style Selector="Border.chip.live TextBlock"><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Border.chip.live Ellipse"><Setter Property="Fill" Value="White" /></Style>
  <Style Selector="Border.chip.pinned"><Setter Property="Background" Value="{StaticResource TintPinned}" /></Style>
  <Style Selector="Border.chip.pinned TextBlock"><Setter Property="Foreground" Value="{StaticResource Pinned}" /></Style>
  <Style Selector="Border.chip.pinned Ellipse"><Setter Property="Fill" Value="{StaticResource Pinned}" /></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{StaticResource TintWarn}" /></Style>
  <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{StaticResource Warn}" /></Style>
  <Style Selector="Border.chip.warn Ellipse"><Setter Property="Fill" Value="{StaticResource Warn}" /></Style>
  <Style Selector="Border.chip.bad"><Setter Property="Background" Value="{StaticResource TintLive}" /></Style>
  <Style Selector="Border.chip.bad TextBlock"><Setter Property="Foreground" Value="{StaticResource Live}" /></Style>
  <Style Selector="Border.chip.bad Ellipse"><Setter Property="Fill" Value="{StaticResource Live}" /></Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface4}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E8CB8E" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D4B06A" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#66E2BE76" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>

  <Style Selector="Button.onair">
    <Setter Property="Background" Value="{StaticResource Live}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.onair:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FF7073" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.pin">
    <Setter Property="Background" Value="{StaticResource TintPinned}" />
    <Setter Property="Foreground" Value="{StaticResource Pinned}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#335AA9F0" />
    <Setter Property="Foreground" Value="{StaticResource Pinned}" />
  </Style>

  <Style Selector="Button.takedown">
    <Setter Property="Background" Value="{StaticResource TintLive}" />
    <Setter Property="Foreground" Value="{StaticResource Live}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.takedown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FF5A5F" />
    <Setter Property="Foreground" Value="{StaticResource Live}" />
  </Style>

  <Style Selector="Button.warn">
    <Setter Property="Background" Value="{StaticResource TintWarn}" />
    <Setter Property="Foreground" Value="{StaticResource Warn}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33F0B44C" />
    <Setter Property="Foreground" Value="{StaticResource Warn}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#EED7A6" />
  </Style>

  <Style Selector="Button.big">
    <Setter Property="Padding" Value="20,12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- Toggle "selected" state for segmented / tab-like buttons -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
  </Style>

  <!-- Side rail -->
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail.selected">
    <Setter Property="Background" Value="{StaticResource Surface3}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Surface3}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- Icon default -->
  <Style Selector="c|Icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
</Styles>
