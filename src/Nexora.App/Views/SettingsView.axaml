<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexora.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:m="using:Nexora.Core.Model"
             x:Class="Nexora.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style Selector="Button.userrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.userrow.selected">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="230,*">
    <!-- Settings navigation -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,16">
      <ItemsControl ItemsSource="{Binding NavItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavItem">
            <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).GoCommand}" CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="11">
                <c:Icon Kind="{Binding Icon}" Width="17" Height="17" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Panel Margin="32,26,32,32">

        <!-- ============ Church branding ============ -->
        <StackPanel IsVisible="{Binding IsBranding}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock Classes="h1" Text="Church branding" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Shown on the sign-in screen and the logo screen. Change it once and every PC on the network picks it up." />
            </StackPanel>
            <Border Grid.Column="1" Classes="chip ok" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding SavedText}" /></StackPanel>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="*,28,*">
            <StackPanel Spacing="16">
              <Border Classes="panel" Padding="16" BorderBrush="{StaticResource Line2}">
                <Grid ColumnDefinitions="Auto,16,*,Auto">
                  <Border Width="120" Height="64" CornerRadius="10" Background="{StaticResource Surface3}" ClipToBounds="True">
                    <Panel>
                      <TextBlock Text="{Binding ChurchInitials}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasLogo}" />
                      <Image Source="{Binding LogoBitmap}" Margin="6" IsVisible="{Binding HasLogo}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="Church logo" FontWeight="Bold" />
                    <TextBlock Classes="faint small" TextWrapping="Wrap" Text="PNG or JPG. A transparent background works best." />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="small" Command="{Binding UploadLogoCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="upload" Width="13" Height="13" />
                        <TextBlock Text="Upload logo" />
                      </StackPanel>
                    </Button>
                    <Button Classes="link small" Content="Remove" HorizontalAlignment="Center" Command="{Binding RemoveLogoCommand}" IsVisible="{Binding HasLogo}" />
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel>
                <TextBlock Classes="label" Text="Church name" />
                <TextBox Text="{Binding ChurchName}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Address" />
                <TextBox Text="{Binding ChurchAddress}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" VerticalContentAlignment="Top" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Logo screen line" />
                <TextBox Text="{Binding LogoLine}" />
              </StackPanel>
              <Border Classes="panel">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="Use branding on" />
                  <Grid ColumnDefinitions="*,Auto" Classes="row">
                    <TextBlock Text="Sign-in screen" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOnSignIn}" OnContent="" OffContent="" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Classes="row">
                    <TextBlock Text="Logo screen when nothing is live" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding LogoWhenIdle}" OnContent="" OffContent="" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" Classes="row">
                    <TextBlock Text="Small logo in the corner of the recording and stream" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CornerWatermark}" OnContent="" OffContent="" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="10">
              <TextBlock Classes="label" Text="Logo screen on the audience screen" />
              <Border CornerRadius="12" ClipToBounds="True" BorderBrush="{StaticResource Line2}" BorderThickness="1">
                <c:ScreenView Branding="{Binding PreviewBranding}" Animate="False" />
              </Border>
              <TextBlock Classes="label" Text="Sign-in screen" Margin="0,12,0,6" />
              <Border Background="#0E0F11" CornerRadius="12" Padding="16" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,14,*">
                  <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource Surface3}" ClipToBounds="True">
                    <Panel>
                      <TextBlock Text="{Binding ChurchInitials}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasLogo}" />
                      <Image Source="{Binding LogoBitmap}" Margin="4" IsVisible="{Binding HasLogo}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChurchName}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding ChurchAddress}" Classes="muted small" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ============ This PC ============ -->
        <StackPanel IsVisible="{Binding IsPc}" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="This PC" />
            <TextBlock Classes="muted" Text="{Binding PcRoleText}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Name of this PC" />
              <TextBox Text="{Binding PcName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Pairing code" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding PairingCode}" FontFamily="{StaticResource FontMono}" />
                <Button Grid.Column="1" Classes="ghost small" Margin="6,0,0,0" Command="{Binding NewPairingCodeCommand}" IsVisible="{Binding IsLiveOutputPc}" ToolTip.Tip="Make a new code">
                  <c:Icon Kind="refresh" Width="15" Height="15" />
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
          <StackPanel IsVisible="{Binding IsTerminalPc}">
            <TextBlock Classes="label" Text="Live Output PC address (leave empty to find it automatically)" />
            <TextBox Text="{Binding ManualAddress}" Watermark="For example: 192.168.1.20" FontFamily="{StaticResource FontMono}" />
          </StackPanel>
          <Border Classes="panel" IsVisible="{Binding IsLiveOutputPc}">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Addresses of this PC on the church network" />
              <TextBlock Text="{Binding LanAddresses}" Classes="mono" TextWrapping="Wrap" />
              <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Terminals normally find this PC by themselves. Type one of these on a terminal only if it cannot." />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="Save" Command="{Binding SavePcCommand}" />
            <Button Command="{Binding AllowFirewallCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <c:Icon Kind="shield" Width="14" Height="14" />
                <TextBlock Text="Allow NEXORA through Windows Firewall" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding PcMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"
                     IsVisible="{Binding PcMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Classes="hairline" />
          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="Set up this PC again" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Change this PC between Live Output and Terminal. Users and settings stored on this PC are kept." />
            <Button Classes="takedown" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Run the set-up again" Command="{Binding ResetPcCommand}" />
          </StackPanel>
          <TextBlock Classes="faint small">
            <Run Text="NEXORA " /><Run Text="{Binding VersionText}" /><Run Text="   ·   Data folder: " /><Run Text="{Binding DataFolder}" FontFamily="{StaticResource FontMono}" />
          </TextBlock>
        </StackPanel>

        <!-- ============ Screens & outputs ============ -->
        <StackPanel IsVisible="{Binding IsScreens}" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Screens &amp; outputs" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Each named screen is one output of the Live Output PC. Choose which display it fills. 'Window' shows it in a normal window, handy for testing on one monitor." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ScreenEdits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScreenEdit">
                <Border Classes="panel" Margin="0,0,0,12" Padding="16">
                  <Grid ColumnDefinitions="2*,14,2*,14,2*,14,Auto,14,Auto">
                    <StackPanel>
                      <TextBlock Classes="label" Text="Name" />
                      <TextBox Text="{Binding Name}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="label" Text="Look" />
                      <ComboBox SelectedIndex="{Binding KindIndex}"
                                ItemsSource="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).KindOptions}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Classes="label" Text="Shows on" />
                      <ComboBox SelectedIndex="{Binding DisplayIndex}"
                                ItemsSource="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DisplayOptions}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                      <TextBlock Classes="label" Text="One text at a time" ToolTip.Tip="Pinning Scripture live takes Lyrics down on this screen, and the other way round." />
                      <ToggleSwitch IsChecked="{Binding OneTextSource}" OnContent="" OffContent="" />
                    </StackPanel>
                    <Button Grid.Column="8" Classes="ghost" VerticalAlignment="Bottom" ToolTip.Tip="Remove this screen"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveScreenCommand}" CommandParameter="{Binding}">
                      <c:Icon Kind="trash" Width="16" Height="16" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Command="{Binding AddScreenCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="plus" Width="14" Height="14" />
                <TextBlock Text="Add screen" />
              </StackPanel>
            </Button>
            <Button Classes="primary" Content="Save screens" Command="{Binding SaveScreensCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ScreensMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}"
                     IsVisible="{Binding ScreensMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- ============ Users & PINs ============ -->
        <StackPanel IsVisible="{Binding IsUsers}" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Users &amp; PINs" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Each person has their own name and 4-digit PIN. Their roles decide which sections they can open. Users are stored on the Live Output PC and work on every terminal." />
          </StackPanel>
          <Grid ColumnDefinitions="300,24,*">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding UserEdits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UserEdit">
                    <Button Classes="userrow" Classes.selected="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectUserCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,12,*">
                        <Border Classes="avatar">
                          <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                          <TextBlock Text="{Binding RolesText}" Classes="faint small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Margin="0,8,0,0" Command="{Binding AddUserCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="plus" Width="14" Height="14" />
                  <TextBlock Text="Add user" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelectedUser}" VerticalAlignment="Top">
              <StackPanel Spacing="14" DataContext="{Binding SelectedUser}" x:DataType="vm:UserEdit">
                <Grid ColumnDefinitions="*,14,*">
                  <StackPanel>
                    <TextBlock Classes="label" Text="Name" />
                    <TextBox Text="{Binding Name}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="label" Text="Title (optional)" />
                    <TextBox Text="{Binding Title}" Watermark="For example: Media lead" />
                  </StackPanel>
                </Grid>
                <StackPanel>
                  <TextBlock Classes="label" Text="PIN" />
                  <TextBox Text="{Binding Pin}" PasswordChar="•" MaxLength="4" Width="180" HorizontalAlignment="Left" Watermark="4 digits" />
                  <TextBlock Classes="faint small" Margin="0,4,0,0" Text="{Binding PinHint}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="Roles" />
                  <UniformGrid Columns="3">
                    <CheckBox Content="Admin" IsChecked="{Binding Admin}" />
                    <CheckBox Content="Live Output" IsChecked="{Binding LiveOutput}" />
                    <CheckBox Content="Scripture" IsChecked="{Binding Scripture}" />
                    <CheckBox Content="Song Lyrics" IsChecked="{Binding Lyrics}" />
                    <CheckBox Content="Camera Switcher" IsChecked="{Binding Camera}" />
                    <CheckBox Content="Announcements" IsChecked="{Binding Announcements}" />
                    <CheckBox Content="Lower Thirds" IsChecked="{Binding LowerThirds}" />
                    <CheckBox Content="Countdown and Minister Timer" IsChecked="{Binding Countdown}" />
                    <CheckBox Content="Trainee (practice only)" IsChecked="{Binding Trainee}" />
                  </UniformGrid>
                </StackPanel>
                <TextBlock Text="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).UsersMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary" Content="Save user" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SaveUserCommand}" />
                  <Button Classes="takedown" Content="Remove" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteUserCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- ============ Bibles & Scripture ============ -->
        <StackPanel IsVisible="{Binding IsBibles}" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Bibles &amp; Scripture" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The translations every PC can show. Add a Bible file here and NEXORA checks every verse from Genesis 1:1 to Revelation 22:21, then copies it to every PC." />
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Classes="h3" Text="Defaults" />
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="6">
                  <TextBlock Classes="flabel" Text="Translation a new Scripture section starts with" />
                  <ComboBox ItemsSource="{Binding TranslationOptions}" SelectedItem="{Binding DefaultTranslation}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="flabel" Text="Theme a new Scripture section starts with" />
                  <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding DefaultTheme}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h3" Text="Add a translation" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Zefania or OSIS XML, USFM, MyBible or other SQLite Bibles, JSON, CSV, or a zip with any of these." />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Command="{Binding ChooseBibleFileCommand}" IsEnabled="{Binding !BiblesBusy}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Kind="upload" Width="15" Height="15" />
                    <TextBlock Text="Choose file…" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border Classes="panel" IsVisible="{Binding HasPending}">
                <StackPanel Spacing="12">
                  <TextBlock Classes="muted small" Text="{Binding PendingFile}" />
                  <Grid ColumnDefinitions="160,16,*">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="flabel" Text="Short name" />
                      <TextBox Text="{Binding PendingAbbrev}" MaxLength="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Classes="flabel" Text="Full name" />
                      <TextBox Text="{Binding PendingName}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <c:Icon Kind="check" Width="15" Height="15" Margin="0,2,8,0" VerticalAlignment="Top" IsVisible="{Binding PendingComplete}" Foreground="{StaticResource PreviewBrush}" />
                    <c:Icon Kind="info" Width="15" Height="15" Margin="0,2,8,0" VerticalAlignment="Top" IsVisible="{Binding !PendingComplete}" Foreground="{StaticResource Warn}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding PendingReport}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding CancelBibleCommand}">Cancel</Button>
                    <Button Classes="primary" Command="{Binding AddBibleCommand}" IsEnabled="{Binding !BiblesBusy}">Add to every PC</Button>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding BiblesMessage}" IsVisible="{Binding BiblesMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="0">
            <ItemsControl ItemsSource="{Binding BibleRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BibleRow">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid ColumnDefinitions="80,*,Auto,Auto">
                      <TextBlock Text="{Binding Abbrev}" Classes="mono" FontWeight="Bold" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Kind}" Classes="faint small" VerticalAlignment="Center" Margin="12,0" />
                      <Button Grid.Column="3" Classes="ghost small" IsVisible="{Binding Imported}" VerticalAlignment="Center"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveBibleCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Kind="trash" Width="13" Height="13" />
                          <TextBlock Text="Remove" IsVisible="{Binding !ConfirmRemove}" />
                          <TextBlock Text="Press again to remove" IsVisible="{Binding ConfirmRemove}" Foreground="{StaticResource Warn}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- ============ Network ============ -->
        <StackPanel IsVisible="{Binding IsNetwork}" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Network" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Every NEXORA program connected to the Live Output PC right now." />
          </StackPanel>
          <Border Classes="card" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="2*,1.4*,1.4*,1.4*,2*,*" Margin="18,12">
                <TextBlock Classes="eyebrow" Text="PC" />
                <TextBlock Grid.Column="1" Classes="eyebrow" Text="TYPE" />
                <TextBlock Grid.Column="2" Classes="eyebrow" Text="USER" />
                <TextBlock Grid.Column="3" Classes="eyebrow" Text="ADDRESS" />
                <TextBlock Grid.Column="4" Classes="eyebrow" Text="SECTIONS" />
                <TextBlock Grid.Column="5" Classes="eyebrow" Text="VERSION" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Clients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClientRow">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,11">
                      <Grid ColumnDefinitions="2*,1.4*,1.4*,1.4*,2*,*">
                        <TextBlock Text="{Binding PcName}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="muted" />
                        <TextBlock Grid.Column="2" Text="{Binding User}" Classes="muted" />
                        <TextBlock Grid.Column="3" Text="{Binding Address}" Classes="mono muted" />
                        <TextBlock Grid.Column="4" Text="{Binding Sections}" Classes="muted" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding Version}" Classes="mono faint" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ Lyrics & CCLI ============ -->
        <StackPanel IsVisible="{Binding IsLyrics}" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Lyrics &amp; CCLI" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The church's CCLI licence, the starting look for songs, and the song usage report." />
          </StackPanel>
          <Grid ColumnDefinitions="*,28,*">
            <Border Classes="card" Padding="18">
              <StackPanel Spacing="12">
                <StackPanel>
                  <TextBlock Classes="label" Text="CCLI licence number" />
                  <TextBox Text="{Binding CcliLicence}" Watermark="e.g. 1234567" MaxLength="20" />
                </StackPanel>
                <CheckBox Content="Show the song's copyright and CCLI line on its first slide" IsChecked="{Binding CopyrightOnFirst}" />
                <StackPanel>
                  <TextBlock Classes="label" Text="Starting look for songs" />
                  <ComboBox ItemsSource="{Binding LyricThemeList}" SelectedItem="{Binding LyricTheme}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="m:ScriptureTheme"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Grid ColumnDefinitions="*,12,*,12,*">
                  <StackPanel>
                    <TextBlock Classes="label" Text="Animation" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Animations}" SelectedItem="{Binding LyricAnimation}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="label" Text="Speed (ms)" />
                    <NumericUpDown Value="{Binding LyricAnimationMs}" Minimum="0" Maximum="3000" Increment="50" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Classes="label" Text="Lines per slide" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.LinesChoices}" SelectedItem="{Binding LinesPerSlide}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Lines per slide 0 keeps each part as typed. A song can still choose its own." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveLyricsCommand}" />
                  <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding LyricsMessage}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h3" Text="Song usage report" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Periods}" SelectedItem="{Binding UsagePeriod}" Width="160" />
                </Grid>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding UsageSummary}" />
                <ItemsControl ItemsSource="{Binding Usage}" MaxHeight="360">
                  <ItemsControl.Template>
                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UsageRow">
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="faint small" Text="{Binding CcliText}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Times, StringFormat='{}{0}×'}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="small" HorizontalAlignment="Left" Command="{Binding ExportUsageCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="download" Width="13" Height="13" /><TextBlock Text="Save as a spreadsheet (CSV)" /></StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- ============ Recording & streaming ============ -->
        <StackPanel IsVisible="{Binding IsBroadcast}" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Recording &amp; streaming" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The recording and the live stream carry the Broadcast screen, with sound from the mixer. Start and stop them on the Live Output screen." />
          </StackPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding EncoderText}" />
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="Recording" />
              <StackPanel>
                <TextBlock Classes="label" Text="Save recordings to" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox Text="{Binding RecordFolder}" />
                  <Button Grid.Column="2" Content="Choose…" Command="{Binding ChooseRecordFolderCommand}" />
                </Grid>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Service name (used in the file name)" />
                <TextBox Text="{Binding DefaultServiceName}" />
              </StackPanel>
              <CheckBox Content="Also record the cameras alone, without words (a clean copy for editing)" IsChecked="{Binding CleanRecording}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="Picture and sound" />
              <Grid ColumnDefinitions="*,12,*,12,*">
                <StackPanel>
                  <TextBlock Classes="label" Text="Size" />
                  <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.HeightChoices}" SelectedItem="{Binding VideoHeight}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="label" Text="Frames a second" />
                  <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.FpsChoices}" SelectedItem="{Binding VideoFps}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Classes="label" Text="Quality (kbps)" />
                  <NumericUpDown Value="{Binding VideoKbps}" Minimum="1000" Maximum="20000" Increment="500" FormatString="0" />
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Classes="label" Text="Sound from" />
                <ComboBox ItemsSource="{Binding SoundInputs}" SelectedItem="{Binding SoundInput}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="faint small" TextWrapping="Wrap" Margin="0,4,0,0" Text="Pick the input the sound desk feeds (a USB audio interface or the capture card's audio)." />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Delay the sound by (ms)" />
                <NumericUpDown Value="{Binding SoundDelayMs}" Minimum="0" Maximum="2000" Increment="20" FormatString="0" Width="160" HorizontalAlignment="Left" />
                <TextBlock Classes="faint small" TextWrapping="Wrap" Margin="0,4,0,0" Text="If lips move after the words are heard, add a delay (try 100 to 200 ms with NDI cameras)." />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="Live stream" />
              <StackPanel>
                <TextBlock Classes="label" Text="Stream address (RTMP URL)" />
                <TextBox Text="{Binding StreamUrl}" Watermark="rtmp://a.rtmp.youtube.com/live2" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Stream key" />
                <TextBox Text="{Binding StreamKey}" PasswordChar="•" Watermark="Paste the key from YouTube Studio or Facebook" />
                <TextBlock Classes="faint small" Margin="0,4,0,0" Text="A key is saved. Leave this empty to keep it." IsVisible="{Binding HasStreamKey}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="Save" Command="{Binding SaveBroadcastCommand}" />
            <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BroadcastMessage}" />
          </StackPanel>
        </StackPanel>

        <!-- ============ Backups & standby ============ -->
        <StackPanel IsVisible="{Binding IsBackups}" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Backups &amp; standby" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="A backup holds users, settings, songs, themes, announcements, people, imported Bibles and uploaded pictures. Videos and recordings are not included." />
          </StackPanel>
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="Backup now" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="The Live Output PC also saves a backup every night and keeps the last 30." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding DownloadBackupCommand}" IsEnabled="{Binding !BackupBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="download" Width="13" Height="13" /><TextBlock Text="Save a backup…" /></StackPanel>
                </Button>
                <Button Command="{Binding RestoreFromFileCommand}" IsEnabled="{Binding !BackupBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="upload" Width="13" Height="13" /><TextBlock Text="Restore from a file…" /></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding BackupMessage}" IsVisible="{Binding BackupMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="0" IsVisible="{Binding !IsTerminal}">
            <StackPanel>
              <TextBlock Classes="h3" Text="Nightly backups on this PC" Margin="18,14,18,8" />
              <ItemsControl ItemsSource="{Binding NightlyBackups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupRow">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="faint small mono" VerticalAlignment="Center" Margin="12,0" />
                        <Button Grid.Column="2" Classes="ghost small" Content="Restore this"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RestoreNightlyCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="faint small" Margin="18,4,18,14" Text="The first one is saved tonight after 2 AM." IsVisible="{Binding !NightlyBackups.Count}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="18" IsVisible="{Binding IsTerminal}">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="If the Live Output PC fails" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding StandbyText}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="This PC can take over as the Live Output PC with that copy. The other terminals find it by themselves. Connect the screens to this PC, then press the button. Only do this if the Live Output PC cannot be started again." />
              <Button Classes="warn" HorizontalAlignment="Left" Command="{Binding AskPromoteCommand}" IsVisible="{Binding !ConfirmPromote}" IsEnabled="{Binding HasStandby}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="live" Width="13" Height="13" /><TextBlock Text="Make this PC the Live Output PC…" /></StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmPromote}">
                <Button Classes="onair" Content="Yes, take over now" Command="{Binding PromoteCommand}" IsEnabled="{Binding !BackupBusy}" />
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelPromoteCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ Updates ============ -->
        <StackPanel IsVisible="{Binding IsUpdates}" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Updates" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The Live Output PC hands new versions to every PC over the church network. No internet is needed on the terminals." />
          </StackPanel>
          <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="This PC" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UpdateState}" />
              <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstall}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="download" Width="13" Height="13" /><TextBlock Text="Install the offered version" /></StackPanel>
              </Button>
              <TextBlock Classes="faint small" TextWrapping="Wrap" Text="A terminal on an older version can still sign in, but cannot be pinned live until it is updated." />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="18" IsVisible="{Binding !IsTerminal}">
            <StackPanel Spacing="12">
              <TextBlock Classes="h3" Text="Offer a new version to every PC" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Download the update files (NEXORA-Update folder: releases.win.json and the .nupkg) onto this PC, then choose releases.win.json here." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding OfferUpdateCommand}" IsEnabled="{Binding !UpdateBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="upload" Width="13" Height="13" /><TextBlock Text="Choose the update files…" /></StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding RollBackCommand}" IsVisible="{Binding HasPrevious}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="restart" Width="13" Height="13" /><TextBlock Text="{Binding PreviousVersion, StringFormat='Go back to {0}'}" /></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UpdateMessage}" IsVisible="{Binding UpdateMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
