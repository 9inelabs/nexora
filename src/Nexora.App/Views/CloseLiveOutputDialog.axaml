<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.App.Views.CloseLiveOutputDialog"
        Title="Close NEXORA"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface1}">
  <StackPanel Margin="28" Spacing="14">
    <TextBlock Classes="h2" Text="Close the Live Output control screen?" />
    <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="20"
               Text="Terminals lose their connection until NEXORA is opened again. You can keep the audience screens showing their current picture, or turn them off too." />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Close everything" Click="OnEverything" Classes="takedown" />
      <Button Content="Close, keep screens on" Click="OnKeep" Classes="primary" />
    </StackPanel>
  </StackPanel>
</Window>
