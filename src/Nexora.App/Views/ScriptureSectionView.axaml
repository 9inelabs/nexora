<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexora.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:m="using:Nexora.Core.Model"
             xmlns:v="using:Nexora.App.Views"
             x:Class="Nexora.App.Views.ScriptureSectionView"
             x:DataType="vm:ScriptureSectionViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.ref">
      <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="48,14,16,14" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.verse">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.verse.selected">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Button.verse.current">
      <Setter Property="Background" Value="{StaticResource TintPreview}" />
    </Style>
    <Style Selector="Button.verse.showing">
      <Setter Property="Background" Value="{StaticResource TintLive}" />
    </Style>
    <Style Selector="Button.trchip">
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Button.trchip.on">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.trchip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.row.current">
      <Setter Property="Background" Value="{StaticResource TintAccent}" />
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface4}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fval">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,-8,0,-6" />
    </Style>
    <Style Selector="TextBox.hex">
      <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="34,5,8,5" />
    </Style>
    <Style Selector="TextBlock.sect">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource Text3}" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="Border.heard">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.heard.pending">
      <Setter Property="BorderBrush" Value="{StaticResource Live}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.heard.used">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="20,16,20,18">
    <!-- On-air bars -->
    <StackPanel Spacing="6" Margin="0,0,0,12">
      <ItemsControl ItemsSource="{Binding Bars}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AirBar">
            <Panel>
              <Border CornerRadius="10" Padding="14,9" Margin="0,0,0,6" Background="{StaticResource Live}" IsVisible="{Binding IsLive}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="Bold" LetterSpacing="0.6" />
                  <TextBlock Text="Enter sends, the arrow keys step, and the screen follows." Foreground="#E6FFFFFF" Margin="10,0,0,0" />
                </StackPanel>
              </Border>
              <Border CornerRadius="10" Padding="14,9" Margin="0,0,0,6" Background="{StaticResource TintWarn}" IsVisible="{Binding IsStandby}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Text}" Foreground="{StaticResource Warn}" FontWeight="Bold" LetterSpacing="0.6" />
                  <TextBlock Text="Taken down. Keep preparing; nothing reaches this screen until Live Output brings you back." Foreground="{StaticResource Warn}" Opacity="0.85" Margin="10,0,0,0" />
                </StackPanel>
              </Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border CornerRadius="10" Padding="14,9" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}" BorderThickness="1" IsVisible="{Binding NotRouted}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <c:Icon Kind="info" Width="16" Height="16" Foreground="{StaticResource Text2}" />
          <TextBlock Classes="muted" Text="Not on any screen yet. The Live Output operator pins you live when it is your turn. You can prepare and preview now." />
        </StackPanel>
      </Border>
      <Border CornerRadius="10" Padding="14,9" Background="{StaticResource TintWarn}" IsVisible="{Binding IsTrainee}">
        <TextBlock Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="Trainee: practice mode. Nothing you send reaches the screens." />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="430,18,*,18,Auto">
      <!-- ========== Left: reference box and chapter ========== -->
      <Grid RowDefinitions="Auto,12,*">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <Panel>
              <TextBox x:Name="RefBox" Classes="ref" Text="{Binding RefText}" Watermark="jn 3 16" />
              <c:Icon Kind="search" Width="20" Height="20" Foreground="{StaticResource Text3}" Margin="16,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Panel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding RefMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{StaticResource PreviewBrush}" IsVisible="{Binding RefOk}" />
              <TextBlock Text="{Binding RefMessage}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{StaticResource Warn}" IsVisible="{Binding !RefOk}" />
              <TextBlock Grid.Column="1" Classes="faint small mono" Text="{Binding LookupTime}" IsVisible="{Binding RefOk}" Margin="8,0,0,0" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Suggestions}" IsVisible="{Binding HasSuggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BookChip">
                  <Button Classes="trchip" Margin="0,0,6,6" Content="{Binding Name}"
                          Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickBookCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Translations}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TranslationChip">
                  <Button Classes="trchip" Classes.on="{Binding IsSelected}" Margin="0,0,6,6" Content="{Binding Text}" ToolTip.Tip="{Binding Tip}"
                          Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickTranslationCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="faint small" Text="Preparing the Bibles on this PC (first start only)…" IsVisible="{Binding Preparing}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="8,14,8,8">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="8,0,8,10">
              <TextBlock Classes="h3" Text="{Binding ChapterTitle}" />
              <TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding Translation}" IsVisible="{Binding !SearchMode}" />
              <TextBlock Grid.Column="1" Classes="faint small" Text="{Binding SearchInfo}" IsVisible="{Binding SearchMode}" />
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="VerseScroll" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="VerseList" ItemsSource="{Binding Verses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VerseRow">
                    <Button Classes="verse" Classes.selected="{Binding IsSelected}" Classes.current="{Binding IsCurrent}" Classes.showing="{Binding IsShowing}"
                            Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickVerseCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding Number}" Classes="mono" FontSize="12" Foreground="{StaticResource Accent}" MinWidth="26" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" FontSize="14" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ========== Middle: preview, controls, pastor's list, history ========== -->
      <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="7" Height="7" Fill="{StaticResource PreviewBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Foreground="{StaticResource PreviewBrush}" Text="PREVIEW" />
                <TextBlock Classes="faint small" Text="{Binding SlideInfo}" Margin="6,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="faint small" Text="Enter send  ·  ↑ ↓ step  ·  Esc clear  ·  Alt+1…9 translation" />
            </Grid>
            <Border CornerRadius="10" ClipToBounds="True" BorderBrush="{StaticResource PreviewBrush}" BorderThickness="1.5"
                    MaxWidth="{Binding PreviewMaxWidth}" HorizontalAlignment="Center">
              <c:ScreenView Frame="{Binding PreviewFrame}" Branding="{Binding Branding}" Animate="False" ShowGuides="{Binding ShowGuides}" />
            </Border>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="eyebrow" Text="NEXT" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding NextLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
              <Button Command="{Binding PreviousCommand}" ToolTip.Tip="Previous (↑)">
                <c:Icon Kind="arrowup" Width="16" Height="16" />
              </Button>
              <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding NextCommand}" ToolTip.Tip="Next (↓)">
                <c:Icon Kind="arrowdown" Width="16" Height="16" />
              </Button>
              <CheckBox Grid.Column="2" Margin="14,0,0,0" IsChecked="{Binding OnePerSlide}" Content="One verse per slide" FontSize="13" />
              <Button Grid.Column="4" Classes="ghost" Margin="0,0,8,0" Command="{Binding ClearCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <c:Icon Kind="x" Width="14" Height="14" />
                  <TextBlock Text="Clear" />
                </StackPanel>
              </Button>
              <Button Grid.Column="5" Classes="primary big" Command="{Binding ShowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Send to screen" />
                  <c:Icon Kind="send" Width="15" Height="15" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Translations.Count}">
              <TextBlock Classes="flabel" Text="Side by side with" Margin="0,0,10,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding SecondChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TranslationChip">
                    <Button Classes="trchip" Classes.on="{Binding IsSelected}" Margin="0,0,6,6" Content="{Binding Text}" ToolTip.Tip="{Binding Name}"
                            Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickSecondCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="2*,12,*,12,*">
        <!-- Listening: what the pastor says, and the verses heard -->
        <Border Classes="card" Padding="14,12">
          <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Panel Width="18" Height="18">
                  <c:Icon Kind="mic" Width="18" Height="18" Foreground="{StaticResource Text2}" IsVisible="{Binding !Listening}" />
                  <c:Icon Kind="mic" Width="18" Height="18" Foreground="{StaticResource Accent}" IsVisible="{Binding Listening}" />
                </Panel>
                <TextBlock Classes="h3" Text="Listening" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource Live}" VerticalAlignment="Center" IsVisible="{Binding ListenSpeaking}" ToolTip.Tip="The pastor is speaking" />
                <TextBlock Classes="faint small" Text="{Binding ListenStatus}" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Level meter -->

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost small" Command="{Binding OpenListenSetupCommand}" ToolTip.Tip="Sound, speech model, auto-go-live">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="settings" Width="13" Height="13" />
                    <TextBlock Text="Set up" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost small" Command="{Binding ClearHeardCommand}" IsVisible="{Binding Listening}" Content="Clear" ToolTip.Tip="Clear the cards and the words" />
                <Button Classes="small" Command="{Binding TogglePauseCommand}" IsVisible="{Binding Listening}" ToolTip.Tip="Stop acting on what is heard (prayer, a song), without stopping">
                  <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !ListenPaused}">
                      <c:Icon Kind="pause" Width="12" Height="12" />
                      <TextBlock Text="Pause" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ListenPaused}">
                      <c:Icon Kind="play" Width="12" Height="12" />
                      <TextBlock Text="Resume" />
                    </StackPanel>
                  </Panel>
                </Button>
                <Button Classes="small" Command="{Binding StopListeningCommand}" IsVisible="{Binding Listening}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="stop" Width="12" Height="12" />
                    <TextBlock Text="Stop" />
                  </StackPanel>
                </Button>
                <Button Classes="primary small" Command="{Binding StartListeningCommand}" IsVisible="{Binding ListenOff}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="mic" Width="13" Height="13" />
                    <TextBlock Text="Start listening" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
          <StackPanel Spacing="10">
            <Border Background="{StaticResource TintWarn}" CornerRadius="8" Padding="10,8" IsVisible="{Binding HasListenProblem}">
              <TextBlock Classes="small" Foreground="{StaticResource Warn}" Text="{Binding ListenProblem}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="faint small" TextWrapping="Wrap" IsVisible="{Binding ListenOff}"
                       Text="NEXORA can listen to the pastor and offer the verses they say as cards, on this PC with no internet. Start listening when the sermon begins." />

            <StackPanel Spacing="10" IsVisible="{Binding Listening}">
              <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="120" Height="6" CornerRadius="3" Background="{StaticResource Surface3}" Margin="0,0,10,0" HorizontalAlignment="Left"
                      VerticalAlignment="Center" ToolTip.Tip="The pastor's level as NEXORA hears it">
                <Border Width="{Binding ListenLevelWidth}" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
              </Border>
                <TextBlock Grid.Column="1" Classes="faint small" Text="{Binding ListenSource}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="faint small mono" Text="{Binding ListenDelay}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <!-- The words, as they are written down -->
              <Border Background="{StaticResource Surface2}" CornerRadius="10" Padding="12,9" MinHeight="44">
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                  <Run Text="{Binding TranscriptDone}" Foreground="{StaticResource Text2}" />
                  <Run Text=" " />
                  <Run Text="{Binding TranscriptNow}" Foreground="{StaticResource Text1}" FontStyle="Italic" />
                </TextBlock>
              </Border>

              <!-- About to go live by itself -->
              <Border Background="{StaticResource TintLive}" CornerRadius="10" Padding="12,8" IsVisible="{Binding HasPending}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{StaticResource Live}" Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="small" Margin="10,0,0,0" Command="{Binding StopPendingCommand}" Content="Stop (Esc)" />
                </Grid>
              </Border>

              <!-- References and commands heard -->
              <ItemsControl ItemsSource="{Binding HeardCards}" IsVisible="{Binding HasHeard}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeardCard">
                    <Border Classes="heard" Classes.pending="{Binding IsPending}" Classes.used="{Binding Used}" Margin="0,0,8,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="row" Padding="10,8" MinWidth="150" ToolTip.Tip="Load it in the preview"
                                Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).UseHeardCommand}" CommandParameter="{Binding}">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="eyebrow" Text="{Binding Kindly}" />
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Classes="mono" />
                            <TextBlock Classes="small" Foreground="{StaticResource PreviewBrush}" Text="{Binding TargetText, StringFormat='→ {0}'}" IsVisible="{Binding ShowTarget}" />
                            <TextBlock Classes="faint small" Text="{Binding Said}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,6,6,6" VerticalAlignment="Center">
                          <Button Classes="primary small" Padding="8,5" ToolTip.Tip="Send to the screen now"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).SendHeardCommand}" CommandParameter="{Binding}">
                            <c:Icon Kind="send" Width="12" Height="12" />
                          </Button>
                          <Button Classes="ghost small" Padding="8,5" ToolTip.Tip="Dismiss"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).DismissHeardCommand}" CommandParameter="{Binding}">
                            <c:Icon Kind="x" Width="11" Height="11" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Suggestions by meaning: never automatic -->
              <StackPanel Spacing="6" IsVisible="{Binding HasMeaning}">
                <TextBlock Classes="eyebrow" Text="MAYBE (WHAT THE PASTOR IS TALKING ABOUT)" />
                <ItemsControl ItemsSource="{Binding MeaningCards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MeaningCard">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <Button Classes="row" ToolTip.Tip="Load it in the preview"
                                Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).UseMeaningCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{Binding Reference}" FontWeight="Bold" Classes="mono" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding HasTitle}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Why}" Classes="faint small" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Sure}" Classes="faint small mono" VerticalAlignment="Center" Margin="8,0,0,0" />
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="ghost small" Padding="8,5" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Send to the screen now"
                                Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).SendMeaningCommand}" CommandParameter="{Binding}">
                          <c:Icon Kind="send" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Classes="faint small" Text="{Binding AutoLiveText}" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          </Grid>
        </Border>

          <!-- Pastor's list for the day -->
          <Border Grid.Column="2" Classes="card" Padding="8,14,8,8">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,0,8,8">
                <StackPanel Spacing="1">
                  <TextBlock Classes="h3" Text="Pastor's list" />
                  <TextBlock Classes="faint small" Text="Page Down for the next" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost small" Command="{Binding ClearPlanCommand}" IsVisible="{Binding HasPlan}" Margin="0,0,6,0">Clear</Button>
                <Button Grid.Column="2" Classes="small" Command="{Binding EditPlanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="plus" Width="13" Height="13" />
                    <TextBlock Text="Add" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border Grid.Row="1" Classes="panel" Margin="8,0,8,8" IsVisible="{Binding PlanEditing}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Type or paste the references from the sermon notes, one per line. Words around them become notes." />
                  <TextBox Text="{Binding PlanText}" AcceptsReturn="True" MinHeight="90" MaxHeight="200" TextWrapping="Wrap"
                           Watermark="Psalm 23&#x0a;John 3:16-21 Sermon text&#x0a;Rom 8 28" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost small" Command="{Binding CancelPlanCommand}">Cancel</Button>
                    <Button Classes="primary small" Command="{Binding AddPlanCommand}">Add to the list</Button>
                  </StackPanel>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Classes="faint small" Margin="8,4" TextWrapping="Wrap" IsVisible="{Binding !HasPlan}"
                             Text="Before the service, add the verses the pastor will read. Then just press the next one." />
                  <ItemsControl ItemsSource="{Binding Plan}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlanItem">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Classes="row" Classes.current="{Binding IsCurrent}"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickPlanCommand}" CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="24,*">
                              <TextBlock Text="{Binding Number}" Classes="mono faint" FontSize="12" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Note}" Classes="faint small" IsVisible="{Binding HasNote}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Classes="ghost small" Padding="6" ToolTip.Tip="Remove"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).RemovePlanCommand}" CommandParameter="{Binding}">
                            <c:Icon Kind="x" Width="12" Height="12" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- History of today -->
          <Border Grid.Column="4" Classes="card" Padding="8,14,8,8">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="1" Margin="8,0,8,8">
                <TextBlock Classes="h3" Text="Shown today" />
                <TextBlock Classes="faint small" Text="One click to show again" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Classes="faint small" Margin="8,4" Text="Nothing sent yet today." IsVisible="{Binding !HasHistory}" />
                  <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HistoryItem">
                        <Button Classes="row" Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).PickHistoryCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Translation}" Classes="eyebrow" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="faint small mono" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ========== Right: style ========== -->
      <Border Grid.Column="4" Classes="card" Padding="0" Width="360">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="16,14,16,10" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h3" Text="Style" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" IsChecked="{Binding ShowGuides}" Content="Guides" FontSize="12.5" ToolTip.Tip="Show the safe area and the text box in the preview" />
            </Grid>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:ScriptureTheme">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
            <v:ThemeEditorPanel x:Name="StylePanel" DataContext="{Binding Editor}" Margin="0,0,0,12" />
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12" IsVisible="{Binding MayEditThemes}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,8,*">
                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveThemeCommand}" Content="Save theme" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ResetThemeCommand}" Content="Undo changes" />
              </Grid>
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Text="{Binding NewThemeName}" Watermark="New theme name" />
                <Button Grid.Column="2" Command="{Binding SaveThemeAsNewCommand}" Content="Save as new" />
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button x:Name="ExportTheme" Classes="ghost small" Content="Export…" />
                <Button Grid.Column="1" x:Name="ImportTheme" Classes="ghost small" Content="Import…" Margin="6,0,0,0" />
                <Button Grid.Column="3" Classes="ghost small" Command="{Binding DeleteThemeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="trash" Width="12" Height="12" />
                    <TextBlock Text="Delete" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ========== Listening setup ========== -->
    <Border Grid.RowSpan="2" Background="#B3000000" Margin="-20,-16,-20,-18" IsVisible="{Binding ListenSetupOpen}">
      <Border Classes="card" Width="680" Margin="0,30" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="20,16,14,10">
            <StackPanel Spacing="2">
              <TextBlock Classes="h3" Text="Set up listening" />
              <TextBlock Classes="faint small" Text="For this PC. Everything runs here, with no internet and no cost." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseListenSetupCommand}" VerticalAlignment="Top">
              <c:Icon Kind="x" Width="14" Height="14" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="20,0,24,20">
              <!-- Sound -->
              <TextBlock Classes="sect" Text="WHERE THE PASTOR'S VOICE COMES FROM" />
              <UniformGrid Columns="3" ColumnSpacing="4">
                <ToggleButton Classes="seg" IsChecked="{Binding SourceNexAudio}" Content="NEX-Audio feed" />
                <ToggleButton Classes="seg" IsChecked="{Binding SourceDevice}" Content="Sound input on this PC" />
                <ToggleButton Classes="seg" IsChecked="{Binding SourceNdi}" Content="NDI sound" />
              </UniformGrid>
              <StackPanel Spacing="6" IsVisible="{Binding SourceNexAudio}">
                <TextBlock Classes="faint small" TextWrapping="Wrap"
                           Text="On the sound PC open NEX-Audio > Stream > Speech feed for Scripture and pick the pastor's channel. The feed reaches every NEXORA PC over the church network." />
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Classes="flabel" Text="Only from" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Text="{Binding NexAudioFrom}" Watermark="Any sound PC (leave empty)" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding SourceDevice}">
                <TextBlock Classes="faint small" TextWrapping="Wrap" Text="A USB sound card fed with the pastor's mic from the desk (an aux send, before the room effects)." />
                <Grid ColumnDefinitions="*,8,Auto">
                  <ComboBox ItemsSource="{Binding SoundInputs}" SelectedItem="{Binding SoundInput}" HorizontalAlignment="Stretch" PlaceholderText="Pick a sound input" />
                  <Button Grid.Column="2" Classes="ghost" Command="{Binding RefreshInputsCommand}" ToolTip.Tip="Look again">
                    <c:Icon Kind="refresh" Width="14" Height="14" />
                  </Button>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding SourceNdi}">
                <TextBlock Classes="faint small" TextWrapping="Wrap" Text="The sound of an NDI source, for example a vMix or OBS output that carries the pastor's mic." />
                <Grid ColumnDefinitions="*,8,Auto">
                  <ComboBox ItemsSource="{Binding NdiSources}" SelectedItem="{Binding NdiSource}" HorizontalAlignment="Stretch" PlaceholderText="Pick an NDI source" />
                  <Button Grid.Column="2" Classes="ghost" Command="{Binding RefreshInputsCommand}" ToolTip.Tip="Look again">
                    <c:Icon Kind="refresh" Width="14" Height="14" />
                  </Button>
                </Grid>
              </StackPanel>
              <CheckBox IsChecked="{Binding ReduceNoise}" Content="Reduce noise (for a sound input or a recording with room noise)" FontSize="13" />

              <!-- Speech model -->
              <TextBlock Classes="sect" Text="SPEECH MODEL (WHISPER)" />
              <TextBlock Classes="faint small" TextWrapping="Wrap"
                         Text="Download a model once. Do it on the Live Output PC first: the other PCs then copy it from there over the church network, with no internet." />
              <ItemsControl ItemsSource="{Binding ModelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpeechModelRow">
                    <Border Classes="panel" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Classes="faint small mono" Text="{Binding Detail}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource TintAccent}" CornerRadius="6" Padding="6,1" IsVisible="{Binding Suggested}">
                              <TextBlock Classes="small" Foreground="{StaticResource Accent}" Text="Suits this PC" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="faint small" Text="{Binding Best}" TextWrapping="Wrap" />
                          <TextBlock Classes="small" Foreground="{StaticResource PreviewBrush}" Text="{Binding State}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="primary small" Content="Use" IsVisible="{Binding CanChoose}"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).ChooseModelCommand}" CommandParameter="{Binding}" />
                          <Button Classes="small" IsVisible="{Binding CanGet}"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).DownloadModelCommand}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <c:Icon Kind="download" Width="12" Height="12" />
                              <TextBlock Text="{Binding GetText}" />
                            </StackPanel>
                          </Button>
                          <Button Classes="ghost small" Content="Stop" IsVisible="{Binding Busy}"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).CancelDownloadCommand}" />
                          <Button Classes="ghost small" ToolTip.Tip="Remove from this PC" IsVisible="{Binding Here}"
                                  Command="{Binding $parent[UserControl].((vm:ScriptureSectionViewModel)DataContext).RemoveModelCommand}" CommandParameter="{Binding}">
                            <c:Icon Kind="trash" Width="12" Height="12" />
                          </Button>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding Busy}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="small" Foreground="{StaticResource PreviewBrush}" Text="{Binding ModelMessage}" TextWrapping="Wrap" IsVisible="{Binding ModelMessage.Length}" />
              <Grid ColumnDefinitions="Auto,8,Auto,*">
                <Button x:Name="ImportModel" Classes="ghost small">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="upload" Width="12" Height="12" />
                    <TextBlock Text="Import a model file…" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="small" Command="{Binding SpeedTestCommand}" IsEnabled="{Binding !ModelBusy}" Content="Test this PC's speed" />
              </Grid>
              <TextBlock Classes="small" Text="{Binding SpeedResult}" TextWrapping="Wrap" IsVisible="{Binding SpeedResult.Length}" />
              <CheckBox IsChecked="{Binding UseGraphicsCard}" Content="Use the graphics card when there is one (NVIDIA, AMD or Intel)" FontSize="13" />
              <TextBlock Classes="faint small" Text="{Binding ListenEngine}" IsVisible="{Binding ListenEngine.Length}" />

              <!-- Going live -->
              <TextBlock Classes="sect" Text="GOING TO THE SCREEN" />
              <ToggleSwitch IsChecked="{Binding AutoLive}" OnContent="Auto: exact references and 'next verse' go to the screen by themselves"
                            OffContent="Cards: the operator taps each one (recommended to start with)" FontSize="13" />
              <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding AutoLive}">
                <TextBlock Classes="flabel" Text="Hold before it goes" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Minimum="0.3" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding HoldSeconds}" />
                <TextBlock Grid.Column="2" Classes="fval" Text="{Binding HoldSeconds, StringFormat='{}{0:0.0} s'}" Margin="12,0,0,0" />
              </Grid>
              <TextBlock Classes="faint small" TextWrapping="Wrap" IsVisible="{Binding AutoLive}"
                         Text="During the hold, Esc stops it and Enter sends it at once. A book and chapter alone, and suggestions by meaning, never go by themselves." />
              <CheckBox IsChecked="{Binding FollowTranslation}" Content="Follow the translation the pastor names ('in the Amplified')" FontSize="13" />

              <!-- Suggestions -->
              <TextBlock Classes="sect" Text="SUGGESTIONS BY WHAT IS SAID" />
              <CheckBox IsChecked="{Binding SuggestByMeaning}" Content="Suggest stories and verses the pastor quotes or talks about" FontSize="13" />
              <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding SuggestByMeaning}">
                <TextBlock Classes="flabel" Text="How sure" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Minimum="0.3" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SuggestLevel}" />
                <TextBlock Grid.Column="2" Classes="fval" Text="{Binding SuggestLevelText}" Margin="12,0,0,0" />
              </Grid>
              <TextBlock Classes="faint small" Text="{Binding MeaningStatus}" IsVisible="{Binding MeaningStatus.Length}" TextWrapping="Wrap" />

              <!-- Words -->
              <TextBlock Classes="sect" Text="WORDS TO EXPECT" />
              <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Names, places and phrases this church uses, so they are written down right. Separate them with commas." />
              <TextBox Text="{Binding CustomWords}" AcceptsReturn="False" TextWrapping="Wrap" Watermark="Pastor Adeyemi, Lagos, Holy Ghost fire" />

              <!-- Recordings -->
              <TextBlock Classes="sect" Text="TRY IT WITH A RECORDING" />
              <TextBlock Classes="faint small" TextWrapping="Wrap"
                         Text="Replay plays a recorded sermon into NEXORA as if live, so the cards appear in real time. Scan reads a whole recording as fast as this PC can and writes a report of everything heard, to check how well it works with this pastor and this room." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReplayRecording" Classes="small">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="play" Width="12" Height="12" />
                    <TextBlock Text="Replay a recording…" />
                  </StackPanel>
                </Button>
                <Button x:Name="ScanRecording" Classes="small">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="list" Width="12" Height="12" />
                    <TextBlock Text="Scan a recording…" />
                  </StackPanel>
                </Button>
                <Button Classes="ghost small" Command="{Binding OpenReportCommand}" IsVisible="{Binding ReportPath.Length}" Content="Open the last report" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
