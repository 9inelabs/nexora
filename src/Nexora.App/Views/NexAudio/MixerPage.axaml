<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexora.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:p="using:Nexora.Audio.Plugins"
             x:Class="Nexora.App.Views.NexAudio.MixerPage"
             x:DataType="vm:NexAudioViewModel">
  <Grid RowDefinitions="Auto,10,*">
    <Grid ColumnDefinitions="Auto,16,Auto,12,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="tab small" Classes.selected="{Binding BankLow}" Command="{Binding ShowBankCommand}" CommandParameter="0" Content="Channels 1–16" />
        <Button Classes="tab small" Classes.selected="{Binding BankHigh}" Command="{Binding ShowBankCommand}" CommandParameter="1" Content="Channels 17–32" />
        <Button Classes="tab small" Classes.selected="{Binding BankBuses}" Command="{Binding ShowBankCommand}" CommandParameter="2" Content="Buses" />
      </StackPanel>
      <ComboBox Grid.Column="2" ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" MinWidth="200" VerticalAlignment="Center"
                ToolTip.Tip="Sends on faders: pick a monitor mix or an effect, and every fader shows its send to it." />
      <TextBlock Grid.Column="4" Classes="faint small" Text="{Binding LayerTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="faint small" Text="{Binding LatencyMixText}" VerticalAlignment="Center" />
        <Button Classes="warn small" Command="{Binding ClearSoloCommand}" IsVisible="{Binding AnySolo}" Content="Clear solo" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto">
      <Border Classes="card" Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding VisibleStrips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="10">
        <StackPanel Orientation="Horizontal">
          <ContentControl Content="{Binding LayerStrip}" IsVisible="{Binding OnSendsLayer}" />
          <ContentControl Content="{Binding MainStrip}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:StripView">
      <Border Classes="stripcard" Classes.selected="{Binding IsSelected}">
        <Grid RowDefinitions="Auto,4,Auto,6,Auto,4,Auto,4,Auto,*,Auto,6,Auto,4,Auto">
          <Border Height="4" CornerRadius="2" Background="{Binding Colour, FallbackValue={StaticResource Surface3}}" />
          <Button Grid.Row="2" Classes="ghost small" Command="{Binding SelectCommand}" Padding="2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Open this strip: input, gate, EQ, compressor, effects and sends">
            <StackPanel Spacing="0">
              <TextBlock Classes="eyebrow" Text="{Binding Number}" HorizontalAlignment="Center" FontSize="9.5" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="4" Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding OpenSectionCommand}" CommandParameter="Eq" ToolTip.Tip="Open the EQ">
            <c:EqCurve Height="30" Compact="True" Settings="{Binding Filters}" IsHitTestVisible="False" />
          </Button>
          <Grid Grid.Row="6" ColumnDefinitions="*,3,*,3,*">
            <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" Command="{Binding OpenSectionCommand}" CommandParameter="Eq">
              <Border Classes="ind" Padding="0" Classes.on="{Binding EqOn}" HorizontalAlignment="Stretch"><TextBlock Text="EQ" HorizontalAlignment="Center" /></Border>
            </Button>
            <Button Grid.Column="2" Classes="ghost" Padding="0" HorizontalAlignment="Stretch" Command="{Binding OpenSectionCommand}" CommandParameter="Dynamics">
              <Border Classes="ind" Padding="0" Classes.on="{Binding DynOn}" HorizontalAlignment="Stretch"><TextBlock Text="DYN" HorizontalAlignment="Center" /></Border>
            </Button>
            <Button Grid.Column="4" Classes="ghost" Padding="0" HorizontalAlignment="Stretch" Command="{Binding OpenSectionCommand}" CommandParameter="Effects">
              <Border Classes="ind" Padding="0" Classes.on="{Binding RackOn}" HorizontalAlignment="Stretch"><TextBlock Text="FX" HorizontalAlignment="Center" /></Border>
            </Button>
          </Grid>
          <StackPanel Grid.Row="8" Spacing="2" ToolTip.Tip="How far the gate (G) and compressor (C) are turning this strip down">
            <Grid ColumnDefinitions="10,*"><TextBlock Classes="faint mono" FontSize="8.5" Text="G" /><c:BarMeter Grid.Column="1" Height="4" Minimum="0" Maximum="30" Value="{Binding GateGr}" VerticalAlignment="Center" /></Grid>
            <Grid ColumnDefinitions="10,*"><TextBlock Classes="faint mono" FontSize="8.5" Text="C" /><c:BarMeter Grid.Column="1" Height="4" Minimum="0" Maximum="20" Value="{Binding CompGr}" VerticalAlignment="Center" /></Grid>
          </StackPanel>
          <c:Fader Grid.Row="9" Value="{Binding Fader}" MinHeight="200" IsEnabled="{Binding FaderEnabled}" Margin="0,4,0,0"
                   Meters="{Binding $parent[UserControl].((vm:NexAudioViewModel)DataContext).StripMeters}"
                   MeterIndex="{Binding MeterIndex}" MeterIndexR="{Binding MeterIndexR}" />
          <Grid Grid.Row="10" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="0" VerticalAlignment="Center">
              <TextBlock Classes="mono" FontSize="12.5" Text="{Binding FaderText}" />
              <TextBlock Classes="faint" FontSize="8.5" Text="{Binding LayerNote}" />
            </StackPanel>
            <c:Knob Grid.Column="1" Width="34" Height="44" Bipolar="True" Label="" Text="{Binding PanText}"
                    Position="{Binding PanPosition}" ResetCommand="{Binding CentrePanCommand}" ToolTip.Tip="Pan (balance on stereo strips). Double-click to centre." />
          </Grid>
          <Button Grid.Row="12" Classes="strip mute" Classes.active="{Binding Mute}" Command="{Binding ToggleMuteCommand}" Content="MUTE" Padding="0,6" />
          <Button Grid.Row="14" Classes="strip solo" Classes.active="{Binding Solo}" Command="{Binding ToggleSoloCommand}" Content="SOLO" Padding="0,6" IsVisible="{Binding CanSolo}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
