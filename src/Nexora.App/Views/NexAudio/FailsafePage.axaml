<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexora.App.ViewModels"
             xmlns:c="using:Nexora.App.Controls"
             xmlns:p="using:Nexora.Audio.Plugins"
             x:Class="Nexora.App.Views.NexAudio.FailsafePage"
             x:DataType="vm:NexAudioViewModel">
  <Grid ColumnDefinitions="*,12,*">
    <Border Classes="card" Padding="16" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Classes="chip ok" IsVisible="{Binding Armed}">
            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="Armed" /></StackPanel>
          </Border>
          <Border Classes="chip warn" IsVisible="{Binding HandedOver}">
            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="On the X32" /></StackPanel>
          </Border>
          <TextBlock Classes="h3" Text="{Binding FailsafeStateText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding FailsafeDetail}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="flabel" Text="Arm the failsafe" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Armed}" OnContent="" OffContent="" Margin="0,-6" />
        </Grid>
        <Grid ColumnDefinitions="200,8,*,8,Auto" RowDefinitions="Auto,8,Auto">
          <TextBlock Classes="flabel" Text="X32 scene: NEX-Audio desk" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding X32SceneChoices}" SelectedItem="{Binding DeskScene}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="4" Grid.RowSpan="3" Classes="ghost" Command="{Binding RefreshX32ScenesCommand}" ToolTip.Tip="Read the scene names from the X32 again" VerticalAlignment="Center">
            <c:Icon Kind="refresh" Width="14" Height="14" />
          </Button>
          <TextBlock Grid.Row="2" Classes="flabel" Text="X32 scene: Console only" />
          <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding X32SceneChoices}" SelectedItem="{Binding ConsoleScene}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="200,8,*,8,60">
          <TextBlock Classes="flabel" Text="Hand over after silence of" />
          <Slider Grid.Column="2" Minimum="200" Maximum="2000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding TimeoutMs}" Margin="0,-6" />
          <TextBlock Grid.Column="4" Classes="mono small" Text="{Binding TimeoutMs, StringFormat={}{0:0} ms}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Classes="warn" Command="{Binding HandOverCommand}" IsVisible="{Binding NotHandedOver}" Content="Hand the room to the X32 now" />
          <Button Classes="primary" Command="{Binding ReturnToNexAudioCommand}" IsVisible="{Binding HandedOver}" Content="Return to NEX-Audio" />
        </StackPanel>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
        <TextBlock Classes="eyebrow" Text="SETTING UP THE TWO X32 SCENES (ONCE)" />
        <TextBlock Classes="small" TextWrapping="Wrap" Text="1. On the X32, route the speaker outputs from the card (Routing > XLR Out: Card 1–16). Save as a scene called NEX-Audio desk." />
        <TextBlock Classes="small" TextWrapping="Wrap" Text="2. Route the same outputs from the X32's own buses (Main L/R, Mix 1–16). Save as a scene called Console only. When saving it, recall only routing (leave channel and bus levels out of the scene's scope), so the desk keeps the shadow mix's levels." />
        <TextBlock Classes="small" TextWrapping="Wrap" Text="3. Assign a user button on the X32 to recall Console only. That is the manual failsafe: one press and the X32 runs the room." />
        <TextBlock Classes="small" TextWrapping="Wrap" Text="4. Pick both scenes above and arm the failsafe before each service." />
      </StackPanel>
    </Border>
    <Border Grid.Column="2" Classes="card" Padding="16" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Classes="h3" Text="Keeping the X32 in step" />
        <TextBlock Classes="small" Foreground="{StaticResource Accent}" Text="{Binding DeskX32Text}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="1">
            <TextBlock Classes="flabel" Text="Shadow mix" />
            <TextBlock Classes="faint small" TextWrapping="Wrap" Text="The X32's own faders, mutes, sends and preamps follow NEX-Audio, so a handover sounds close to what people were hearing." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShadowOn}" OnContent="" OffContent="" VerticalAlignment="Top" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="1">
            <TextBlock Classes="flabel" Text="Follow the desk" />
            <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Moving a fader or mute on the X32 moves it in NEX-Audio too, so the engineer can mix from the console's own faders." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding FollowDesk}" OnContent="" OffContent="" VerticalAlignment="Top" />
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,4" />
        <TextBlock Classes="flabel" Text="Live Output PC" />
        <TextBlock Classes="faint small" TextWrapping="Wrap" Text="Gets the stream mix and watches NEX-Audio's heartbeat. If NEX-Audio goes quiet, the Live Output PC recalls Console only on the X32, even if this PC has lost power." />
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Text="{Binding LiveOutputHost}" Watermark="Live Output PC address, for example 192.168.1.20" />
          <Button Grid.Column="2" Command="{Binding SaveLiveOutputHostCommand}" Content="Save" />
        </Grid>
        <TextBlock Classes="small" Foreground="{StaticResource Accent}" Text="{Binding StreamLinkText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
